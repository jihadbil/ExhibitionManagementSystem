    <!-- Commercial: #EC4899 → #F43F5E -->
    <LinearGradientBrush x:Key="CommercialGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#EC4899" Offset="0"/>
