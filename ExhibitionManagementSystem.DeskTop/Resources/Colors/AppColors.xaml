<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════
         PRIMARY COLORS
    ═══════════════════════════════════════════════════════ -->
    <Color x:Key="PrimaryColor">#FF6366F1</Color>
    <Color x:Key="PrimaryDarkColor">#FF4F46E5</Color>
    <Color x:Key="SecondaryColor">#FF8B5CF6</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>

    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF6366F1" Offset="0"/>
        <GradientStop Color="#FF8B5CF6" Offset="1"/>
    </LinearGradientBrush>

    <!-- ═══════════════════════════════════════════════════════
         BACKGROUNDS
    ═══════════════════════════════════════════════════════ -->
    <Color x:Key="BgMainColor">#FFF8F9FD</Color>
    <Color x:Key="BgCardColor">#FFFFFFFF</Color>
    <Color x:Key="BgSecondaryColor">#FFF1F5F9</Color>
    <Color x:Key="BgInputColor">#FFF8FAFC</Color>

    <SolidColorBrush x:Key="BgMainBrush" Color="{StaticResource BgMainColor}"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}"/>
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondaryColor}"/>
    <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource BgInputColor}"/>

    <!-- ═══════════════════════════════════════════════════════
         TEXT COLORS
    ═══════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1A1D29"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF64748B"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF94A3B8"/>
    <SolidColorBrush x:Key="TextWhiteBrush" Color="#FFFFFFFF"/>

    <!-- ═══════════════════════════════════════════════════════
         STATUS: SUCCESS
    ═══════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF10B981"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#FF059669"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="#FFD1FAE5"/>

    <!-- ═══════════════════════════════════════════════════════
         STATUS: WARNING
    ═══════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="WarningBrush" Color="#FFF59E0B"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FFD97706"/>
    <SolidColorBrush x:Key="WarningLightBrush" Color="#FFFEF3C7"/>

    <!-- ═══════════════════════════════════════════════════════
         STATUS: DANGER
    ═══════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="DangerBrush" Color="#FFEF4444"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FFDC2626"/>
    <SolidColorBrush x:Key="DangerLightBrush" Color="#FFFEE2E2"/>

    <!-- ═══════════════════════════════════════════════════════
         STATUS: INFO
    ═══════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="InfoBrush" Color="#FF3B82F6"/>
    <SolidColorBrush x:Key="InfoTextBrush" Color="#FF2563EB"/>
    <SolidColorBrush x:Key="InfoLightBrush" Color="#FFDBEAFE"/>

    <!-- ═══════════════════════════════════════════════════════
         BORDERS & SHADOWS
    ═══════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="BorderMainBrush" Color="#FFE2E8F0"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#FF6366F1"/>
    <SolidColorBrush x:Key="SidebarActiveShadowBrush" Color="#4D6366F1"/>

    <!-- CornerRadius Constants -->
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
    <CornerRadius x:Key="RadiusXl">16</CornerRadius>
    <CornerRadius x:Key="RadiusFull">999</CornerRadius>

    <!-- ═══════════════════════════════════════════════════════
         EXHIBITION TYPE GRADIENTS
    ═══════════════════════════════════════════════════════ -->
    <!-- Tech: #3B82F6 → #06B6D4 -->
    <LinearGradientBrush x:Key="TechGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF3B82F6" Offset="0"/>
        <GradientStop Color="#FF06B6D4" Offset="1"/>
    </LinearGradientBrush>

    <!-- Medical: #10B981 → #14B8A6 -->
    <LinearGradientBrush x:Key="MedicalGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF10B981" Offset="0"/>
        <GradientStop Color="#FF14B8A6" Offset="1"/>
    </LinearGradientBrush>

    <!-- Industrial: #F97316 → #DC2626 -->
    <LinearGradientBrush x:Key="IndustrialGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FFF97316" Offset="0"/>
        <GradientStop Color="#FFDC2626" Offset="1"/>
    </LinearGradientBrush>

    <!-- Commercial: #EC4899 → #F43F5E -->
    <LinearGradientBrush x:Key="CommercialGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FFEC4899" Offset="0"/>
        <GradientStop Color="#FFF43F5E" Offset="1"/>
    </LinearGradientBrush>

    <!-- Educational: #8B5CF6 → #6366F1 -->
    <LinearGradientBrush x:Key="EducationalGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF8B5CF6" Offset="0"/>
        <GradientStop Color="#FF6366F1" Offset="1"/>
    </LinearGradientBrush>

    <!-- Automotive: #6B7280 → #475569 -->
    <LinearGradientBrush x:Key="AutomotiveGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF6B7280" Offset="0"/>
        <GradientStop Color="#FF475569" Offset="1"/>
    </LinearGradientBrush>

    <!-- Chart Colors -->
    <SolidColorBrush x:Key="Chart1Brush" Color="#FF6366F1"/>
    <SolidColorBrush x:Key="Chart2Brush" Color="#FF10B981"/>
    <SolidColorBrush x:Key="Chart3Brush" Color="#FFF59E0B"/>
    <SolidColorBrush x:Key="Chart4Brush" Color="#FFEF4444"/>
    <SolidColorBrush x:Key="Chart5Brush" Color="#FF8B5CF6"/>

    <!-- Sidebar -->
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#FFF0F4FF"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#FF64748B"/>

</ResourceDictionary>
