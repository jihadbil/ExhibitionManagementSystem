<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Controls.Forms.ScanTicketFormControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="340" d:DesignWidth="680"
             FlowDirection="RightToLeft">
    <Grid Margin="0" MinWidth="640">
        <Grid.RowDefinitions>
            <!-- Form Content -->
            <RowDefinition Height="*"/>
            <!-- Footer Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,20">
            <StackPanel Margin="0,0,4,0">
                
                <Border Style="{StaticResource FormGroupCardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="🔍 فحص ومسح رمز التذكرة" Style="{StaticResource FormSectionHeaderStyle}" Margin="0,0,0,16"/>

                        <!-- QR Code Input -->
                        <TextBlock Style="{StaticResource LabelStyle}" Margin="0,0,0,8">
                            <Run Text="رمز التذكرة الرقمي (QR Code) "/><Run Text="*" Foreground="{StaticResource DangerBrush}"/>
                        </TextBlock>
                        <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                 Text="{Binding ScannedQrCode, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,0,16"
                                 Tag="امسح الرمز بواسطة قارئ الـ QR أو اكتبه هنا..."/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderMainBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
            <Button Content="🔍 تحقق ومسح التذكرة" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding ScanTicketCommand}"
                    Height="48"
                    HorizontalAlignment="Stretch"/>
        </Border>
    </Grid>
</UserControl>
