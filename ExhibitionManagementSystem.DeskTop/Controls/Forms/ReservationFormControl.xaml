<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Controls.Forms.ReservationFormControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="760" d:DesignHeight="760"
             FlowDirection="RightToLeft">
    <Grid Margin="0" MinWidth="720">
        <Grid.RowDefinitions>
            <!-- Form Fields Scroll Area -->
            <RowDefinition Height="*"/>
            <!-- Footer Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,20">
            <StackPanel Margin="0,0,4,0">
                
                <!-- Section 1: Exhibition & Booth Info -->
                <Border Style="{StaticResource FormGroupCardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="🎪 معلومات المعرض والجناح" Style="{StaticResource FormSectionHeaderStyle}" Margin="0,0,0,16"/>

                        <!-- Exhibition selection -->
                        <TextBlock Style="{StaticResource LabelStyle}" Margin="0,0,0,8">
                            <Run Text="المعرض المستهدف "/><Run Text="*" Foreground="{StaticResource DangerBrush}"/>
                        </TextBlock>
                        <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                                  ItemsSource="{Binding Exhibitions}" 
                                  SelectedValuePath="ExhibitionID" 
                                  DisplayMemberPath="Name" 
                                  SelectedValue="{Binding SelectedExhibitionId}" 
                                  Margin="0,0,0,18"/>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Booth selection -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="الجناح المتاح" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                                          ItemsSource="{Binding AvailableBooths}" 
                                          SelectedValuePath="BoothID" 
                                          DisplayMemberPath="BoothNumber" 
                                          SelectedValue="{Binding SelectedBoothId}"/>
                            </StackPanel>

                            <!-- Booth Type selection -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="نوع الجناح المختار" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                                          SelectedValue="{Binding BoothTypeSelected}" 
                                          SelectedValuePath="Content">
                                    <ComboBoxItem Content="Standard" IsSelected="True"/>
                                    <ComboBoxItem Content="Corner"/>
                                    <ComboBoxItem Content="Premium"/>
                                    <ComboBoxItem Content="VIP"/>
                                    <ComboBoxItem Content="Custom"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Requested Area -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="المساحة المطلوبة (م²)" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                         Text="{Binding RequestedAreaSqM, UpdateSourceTrigger=PropertyChanged}" 
                                         Tag="مثال: 12"/>
                            </StackPanel>

                            <!-- Currency Code -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="عملة المعرض" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                         Text="{Binding CurrencyCode}" 
                                         IsReadOnly="True" 
                                         Background="{StaticResource BgSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 2: Exhibitor Info -->
                <Border Style="{StaticResource FormGroupCardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="🏢 بيانات الشركة العارضة" Style="{StaticResource FormSectionHeaderStyle}" Margin="0,0,0,16"/>

                        <!-- Search Exhibitor -->
                        <TextBlock Style="{StaticResource LabelStyle}" Margin="0,0,0,8">
                            <Run Text="البحث عن الشركة العارضة "/><Run Text="*" Foreground="{StaticResource DangerBrush}"/>
                        </TextBlock>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                     Text="{Binding ExhibitorSearchTerm, UpdateSourceTrigger=PropertyChanged}" 
                                     Tag="اكتب جزءاً من اسم الشركة للبحث..."
                                     Grid.Column="0"/>
                            <Button Content="🔍 بحث" 
                                    Command="{Binding SearchExhibitorCommand}" 
                                    Style="{StaticResource PrimaryButtonStyle}" 
                                    Grid.Column="2" 
                                    Width="110" Height="48"/>
                        </Grid>

                        <!-- Exhibitors List Box -->
                        <ListBox ItemsSource="{Binding SearchedExhibitors}" 
                                 SelectedValuePath="ExhibitorID" 
                                 SelectedValue="{Binding SelectedExhibitorId}" 
                                 Height="120" 
                                 Margin="0,0,0,18"
                                 Background="White"
                                 BorderBrush="{StaticResource BorderMainBrush}"
                                 BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,6">
                                        <TextBlock Text="{Binding CompanyName}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="التصنيف: " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding ExhibitorCategory}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0"/>
                                            <TextBlock Text="الجنسية: " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding Nationality}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Exhibitor Category -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="فئة الشركة" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                                          SelectedValue="{Binding ExhibitorCategory}" 
                                          SelectedValuePath="Content">
                                    <ComboBoxItem Content="Local" IsSelected="True"/>
                                    <ComboBoxItem Content="International"/>
                                    <ComboBoxItem Content="Government"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 3: Additional Services -->
                <Border Style="{StaticResource FormGroupCardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="🛠️ الخدمات الإضافية المخصصة (اختياري)" Style="{StaticResource FormSectionHeaderStyle}" Margin="0,0,0,16"/>
                        
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Service selection -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="الخدمة المطلوبة" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                                          ItemsSource="{Binding AvailableServices}" 
                                          SelectedValuePath="ServiceID" 
                                          DisplayMemberPath="ServiceName" 
                                          SelectedValue="{Binding SelectedServiceId}"/>
                            </StackPanel>

                            <!-- Quantity -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="الكمية" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                         Text="{Binding ServiceQuantity, UpdateSourceTrigger=PropertyChanged}" 
                                         Tag="1"/>
                            </StackPanel>

                            <!-- Add Button -->
                            <Button Content="إضافة ➕" 
                                    Command="{Binding AddServiceCommand}" 
                                    Style="{StaticResource SecondaryButtonStyle}" 
                                    Grid.Column="4" 
                                    VerticalAlignment="Bottom"
                                    Width="105" Height="48"/>
                        </Grid>

                        <!-- Selected Services List -->
                        <TextBlock Text="قائمة الخدمات الإضافية المُضافة:" Style="{StaticResource LabelStyle}" Margin="0,4,0,8"/>
                        <ItemsControl ItemsSource="{Binding SelectedServices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderMainBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10" Background="White">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ServiceName}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Grid.Column="0"/>
                                            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="الكمية: " Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding Quantity}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold"/>
                                                <TextBlock Text=" × " Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding UnitPrice, StringFormat=N2}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text=" "/>
                                                <TextBlock Text="{Binding CurrencyCode}" Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding TotalPrice, StringFormat=N2}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource SuccessTextBrush}" VerticalAlignment="Center" Grid.Column="3"/>
                                            
                                            <Button Content="✕" 
                                                    Command="{Binding DataContext.RemoveServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DangerButtonStyle}" 
                                                    Width="32" Height="32" Padding="0"
                                                    Grid.Column="5"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Section 4: Notes -->
                <Border Style="{StaticResource FormGroupCardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="📝 ملاحظات وتجهيزات لوجستية" Style="{StaticResource FormSectionHeaderStyle}" Margin="0,0,0,16"/>
                        <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                 Height="80" 
                                 TextWrapping="Wrap" 
                                 AcceptsReturn="True" 
                                 VerticalContentAlignment="Top"
                                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" 
                                 Tag="أدخل أية متطلبات أو تجهيزات خاصة بالجناح..."/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderMainBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="✓ حفظ وتأكيد الحجز" 
                        Command="{Binding SaveCommand}" 
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Grid.Column="1" 
                        Width="180" Height="48"
                        Margin="0,0,14,0"/>
                <Button Content="✕ إلغاء" 
                        Command="{Binding CancelCommand}" 
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Grid.Column="2" 
                        Width="120" Height="48"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

