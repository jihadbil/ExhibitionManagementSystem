<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Controls.Forms.VenueFormControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="700" d:DesignHeight="600"
             FlowDirection="RightToLeft">
    <Grid Margin="0" MinWidth="660">
        <Grid.RowDefinitions>
            <!-- Form Fields Scroll Area -->
            <RowDefinition Height="*"/>
            <!-- Footer Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,20">
            <StackPanel Margin="0,0,4,0">
                
                <Border Style="{StaticResource FormGroupCardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="📍 تفاصيل الموقع والمكان" Style="{StaticResource FormSectionHeaderStyle}" Margin="0,0,0,16"/>

                        <!-- Name -->
                        <TextBlock Style="{StaticResource LabelStyle}" Margin="0,0,0,8">
                            <Run Text="اسم الموقع "/><Run Text="*" Foreground="{StaticResource DangerBrush}"/>
                        </TextBlock>
                        <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                 Tag="مثال: مركز الرياض الدولي للمؤتمرات والمعارض"
                                 Margin="0,0,0,18"/>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- City -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="المدينة" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                         Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" 
                                         Tag="الرياض"/>
                            </StackPanel>

                            <!-- Country -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="الدولة" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                         Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}" 
                                         Tag="المملكة العربية السعودية"/>
                            </StackPanel>
                        </Grid>

                        <!-- Address -->
                        <TextBlock Text="العنوان التفصيلي" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                 Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" 
                                 Tag="أدخل العنوان الحي، الشارع، أو الحي السكني"
                                 Margin="0,0,0,18"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- TotalCapacity -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="الطاقة الاستيعابية الإجمالية" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                         Text="{Binding TotalCapacity, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" 
                                         Tag="مثال: 5000"/>
                            </StackPanel>

                            <!-- MapImageURL -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="رابط صورة الخريطة" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                         Text="{Binding MapImageURL, UpdateSourceTrigger=PropertyChanged}" 
                                         Tag="https://..."/>
                            </StackPanel>
                        </Grid>

                        <!-- IsActive (Only editable in edit mode) -->
                        <StackPanel Margin="0,18,0,0" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox Content="الموقع نشط ومتاح للحجوزات والفعاليات" 
                                      IsChecked="{Binding IsActive}" 
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      FontSize="14"
                                      FontFamily="{StaticResource WorkSansMedium}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderMainBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="✓ حفظ الموقع" 
                        Command="{Binding SaveCommand}" 
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Grid.Column="1" 
                        Width="160" Height="48"
                        Margin="0,0,14,0"/>
                <Button Content="✕ إلغاء" 
                        Command="{Binding CancelCommand}" 
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Grid.Column="2" 
                        Width="120" Height="48"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
