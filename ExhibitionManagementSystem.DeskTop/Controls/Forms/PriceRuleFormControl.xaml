<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Controls.Forms.PriceRuleFormControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="660" d:DesignWidth="680"
             FlowDirection="RightToLeft">
    <Grid Margin="0" MinWidth="640">
        <Grid.RowDefinitions>
            <!-- Form Content -->
            <RowDefinition Height="*"/>
            <!-- Footer Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,20">
            <StackPanel Margin="0,0,4,0">
                
                <Border Style="{StaticResource FormGroupCardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="🏷️ محددات وقواعد التسعير" Style="{StaticResource FormSectionHeaderStyle}" Margin="0,0,0,16"/>

                        <!-- Rule Name -->
                        <TextBlock Style="{StaticResource LabelStyle}" Margin="0,0,0,8">
                            <Run Text="اسم قاعدة التسعير "/><Run Text="*" Foreground="{StaticResource DangerBrush}"/>
                        </TextBlock>
                        <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                 Text="{Binding NewRuleName, UpdateSourceTrigger=PropertyChanged}" 
                                 Tag="مثال: تسعير الأجنحة الزاوية 2026"
                                 Margin="0,0,0,18"/>

                        <!-- Target Exhibition -->
                        <TextBlock Text="المعرض المستهدف" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                        <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                                  ItemsSource="{Binding ExhibitionsWithAll}" 
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="ExhibitionID"
                                  SelectedValue="{Binding NewRuleExhibitionId}"
                                  Margin="0,0,0,18"/>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Booth Type -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="نوع الجناح" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                                          ItemsSource="{Binding BoothTypes}" 
                                          SelectedItem="{Binding NewRuleBoothType}"/>
                            </StackPanel>

                            <!-- Category -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="فئة العارض" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                                          ItemsSource="{Binding ExhibitorCategories}" 
                                          SelectedItem="{Binding NewRuleCategory}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Price Per SqM -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelStyle}" Margin="0,0,0,8">
                                    <Run Text="السعر للمتر المربع (م²) "/><Run Text="*" Foreground="{StaticResource DangerBrush}"/>
                                </TextBlock>
                                <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                         Text="{Binding NewRulePricePerSqM, UpdateSourceTrigger=PropertyChanged}" 
                                         Tag="0.00"/>
                            </StackPanel>

                            <!-- Currency -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="العملة" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                                          ItemsSource="{Binding Currencies}" 
                                          DisplayMemberPath="CurrencyName"
                                          SelectedValuePath="CurrencyCode"
                                          SelectedValue="{Binding NewRuleCurrencyCode}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Min Area -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="الحد الأدنى للمساحة (م²)" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                         Text="{Binding NewRuleMinArea, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" 
                                         Tag="مثال: 9"/>
                            </StackPanel>

                            <!-- Max Area -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="الحد الأقصى للمساحة (م²)" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                         Text="{Binding NewRuleMaxArea, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" 
                                         Tag="مثال: 100"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Valid From -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="تاريخ البدء" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <DatePicker SelectedDate="{Binding NewRuleValidFrom, Mode=TwoWay}" Style="{StaticResource StandardDatePickerStyle}"/>
                            </StackPanel>

                            <!-- Valid To -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="تاريخ الانتهاء (اختياري)" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <DatePicker SelectedDate="{Binding NewRuleValidTo, Mode=TwoWay}" Style="{StaticResource StandardDatePickerStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Notes -->
                        <TextBlock Text="ملاحظات وشروط إضافية" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                 Text="{Binding NewRuleNotes, UpdateSourceTrigger=PropertyChanged}" 
                                 AcceptsReturn="True" Height="70" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 Tag="أدخل أية ملاحظات تفصيلية حول القاعدة..."/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderMainBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
            <Button Content="✓ حفظ وإدراج قاعدة التسعير" 
                    Style="{StaticResource PrimaryButtonStyle}" 
                    Command="{Binding SavePriceRuleCommand}" 
                    Height="48" 
                    HorizontalAlignment="Stretch"/>
        </Border>
    </Grid>
</UserControl>
