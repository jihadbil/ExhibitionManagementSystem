<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Controls.Forms.InvoiceDetailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:badges="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Badges"
             mc:Ignorable="d" 
             d:DesignWidth="840" d:DesignHeight="720"
             FlowDirection="RightToLeft">
    <Grid Margin="0" MinWidth="760">
        <Grid.RowDefinitions>
            <!-- Content Scroll Area -->
            <RowDefinition Height="*"/>
            <!-- Footer Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,20">
            <StackPanel Margin="0,0,4,0">
                
                <!-- Section 1: Invoice Info Summary Card -->
                <Border Style="{StaticResource FormGroupCardStyle}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: General Info -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="رقم الفاتورة" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Invoice.InvoiceNumber}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="الشركة العارضة" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Invoice.ExhibitorName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="إجمالي المبلغ" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Invoice.TotalAmount, StringFormat=N2}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SuccessTextBrush}"/>
                                    <TextBlock Text=" "/>
                                    <TextBlock Text="{Binding Invoice.CurrencyCode}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="6">
                                <TextBlock Text="تاريخ الاستحقاق" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Invoice.DueDate, StringFormat=d, TargetNullValue='-'}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Financial Stats & Status -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="المبلغ المدفوع" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding PaidAmount, StringFormat=N2}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource SuccessTextBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="المبلغ المتبقي" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding RemainingAmount, StringFormat=N2}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource DangerTextBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="حالة الفاتورة" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                                <badges:StatusBadgeControl Status="{Binding Invoice.Status}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="6">
                                <TextBlock Text="تاريخ الاصدار" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding Invoice.InvoiceDate, StringFormat=d}" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Section 2: Invoice Items Table Card -->
                <Border Style="{StaticResource FormGroupCardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="📄 بنود الفاتورة التفصيلية" Style="{StaticResource FormSectionHeaderStyle}" Margin="0,0,0,16"/>
                        <DataGrid ItemsSource="{Binding InvoiceItems}"
                                  MinHeight="130"
                                  MaxHeight="200"
                                  Style="{StaticResource AppDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource AppDataGridColumnHeaderStyle}"
                                  RowStyle="{StaticResource AppDataGridRowStyle}"
                                  CellStyle="{StaticResource AppDataGridCellStyle}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="البيان / الصنف" Binding="{Binding ItemName}" Width="2*"/>
                                <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat=N2}" Width="*"/>
                                <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, StringFormat=N2}" Width="*"/>
                                <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalPrice, StringFormat=N2}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Section 3: Payments List Card -->
                <Border Style="{StaticResource FormGroupCardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="💳 سجل المدفوعات المستلمة" Style="{StaticResource FormSectionHeaderStyle}" Margin="0,0,0,16"/>
                        <DataGrid ItemsSource="{Binding Payments}"
                                  MinHeight="130"
                                  MaxHeight="200"
                                  Style="{StaticResource AppDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource AppDataGridColumnHeaderStyle}"
                                  RowStyle="{StaticResource AppDataGridRowStyle}"
                                  CellStyle="{StaticResource AppDataGridCellStyle}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="تاريخ الدفع" Binding="{Binding PaymentDate, StringFormat=d}" Width="*"/>
                                <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding Method}" Width="*"/>
                                <DataGridTextColumn Header="المبلغ المدفوع" Binding="{Binding Amount, StringFormat=N2}" Width="*"/>
                                <DataGridTextColumn Header="رقم المرجع" Binding="{Binding ReferenceNo}" Width="*"/>
                                
                                <DataGridTemplateColumn Header="الحالة" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <badges:StatusBadgeControl Status="{Binding Status}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                
                                <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Section 4: Record New Payment Section -->
                <StackPanel Margin="0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RemainingAmount}" Value="0.00">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RemainingAmount}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Border Style="{StaticResource FormGroupCardStyle}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="💵 تسجيل دفعة مالية جديدة" Style="{StaticResource FormSectionHeaderStyle}" Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Amount to record -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource LabelStyle}" Margin="0,0,0,8">
                                        <Run Text="مبلغ الدفعة "/><Run Text="*" Foreground="{StaticResource DangerBrush}"/>
                                    </TextBlock>
                                    <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                             Text="{Binding NewPaymentAmount, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="0.00"/>
                                </StackPanel>

                                <!-- Method -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="طريقة الدفع" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                    <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                                              ItemsSource="{Binding PaymentMethods}" 
                                              SelectedItem="{Binding NewPaymentMethod}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Reference Number -->
                            <TextBlock Text="رقم المرجع / التحويل / الشيك" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                            <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                     Text="{Binding NewPaymentReference, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="رقم المعاملة البنكية أو الإيصال"
                                     Margin="0,0,0,18"/>

                            <!-- Notes -->
                            <TextBlock Text="ملاحظات الدفع" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                            <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                     Height="70"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     Text="{Binding NewPaymentNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="ملاحظات إضافية على عملية تحصيل الدفعة..."
                                     Margin="0,0,0,18"/>
                            
                            <Button Content="💳 إدراج وتأكيد الدفعة" 
                                    Command="{Binding RecordPaymentCommand}" 
                                    Style="{StaticResource PrimaryButtonStyle}" 
                                    Width="220" Height="48" 
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderMainBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="إغلاق ✕" 
                        Command="{Binding CloseCommand}" 
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Grid.Column="1" 
                        Width="140" Height="48"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

