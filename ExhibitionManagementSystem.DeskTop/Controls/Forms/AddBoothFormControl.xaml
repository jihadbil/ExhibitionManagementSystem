<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Controls.Forms.AddBoothFormControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="680"
             FlowDirection="RightToLeft">
    <Grid Margin="0" MinWidth="640">
        <Grid.RowDefinitions>
            <!-- Form Content Area -->
            <RowDefinition Height="*"/>
            <!-- Footer Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,20">
            <StackPanel Margin="0,0,4,0">
                
                <Border Style="{StaticResource FormGroupCardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="➕ إضافة جناح جديد للمخطط" Style="{StaticResource FormSectionHeaderStyle}" Margin="0,0,0,16"/>

                        <!-- Booth Number -->
                        <TextBlock Style="{StaticResource LabelStyle}" Margin="0,0,0,8">
                            <Run Text="رقم الجناح "/><Run Text="*" Foreground="{StaticResource DangerBrush}"/>
                        </TextBlock>
                        <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                 Text="{Binding NewBoothNumber, UpdateSourceTrigger=PropertyChanged}" 
                                 Tag="أدخل رقم أو اسم الجناح (مثل: B-201)"
                                 Margin="0,0,0,18"/>

                        <!-- Original Area -->
                        <TextBlock Text="المساحة الإجمالية (م²)" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                 Text="{Binding NewOriginalAreaSqM, UpdateSourceTrigger=PropertyChanged}" 
                                 Tag="مثال: 9"
                                 Margin="0,0,0,18"/>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Width -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="العرض (م)" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                         Text="{Binding NewWidth, UpdateSourceTrigger=PropertyChanged}" 
                                         Tag="3"/>
                            </StackPanel>

                            <!-- Height -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="الطول (م)" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                         Text="{Binding NewHeight, UpdateSourceTrigger=PropertyChanged}" 
                                         Tag="3"/>
                            </StackPanel>
                        </Grid>

                        <!-- Category (ShapeType) -->
                        <TextBlock Text="فئة / نوع الجناح" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                        <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                                  ItemsSource="{Binding ShapeTypes}" 
                                  SelectedItem="{Binding NewShapeType}" 
                                  Margin="0,0,0,18"/>

                        <!-- Custom Pricing Rule -->
                        <TextBlock Text="قاعدة تسعير مخصصة (اختياري)" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                        <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                                  ItemsSource="{Binding PricingRules}" 
                                  DisplayMemberPath="RuleName"
                                  SelectedValuePath="RuleID"
                                  SelectedValue="{Binding NewAssignedPriceRuleId}" 
                                  Margin="0,0,0,18"/>

                        <!-- Pricing Preview Box -->
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="💡 معاينة التسعير التقديري" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" Margin="0,0,0,6" FontSize="14"/>
                                <TextBlock Text="{Binding PricingPreviewText}" TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderMainBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
            <Button Content="✓ إضافة الجناح وتثبيته" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SaveBoothCommand}"
                    Height="48"
                    HorizontalAlignment="Stretch"/>
        </Border>
    </Grid>
</UserControl>
