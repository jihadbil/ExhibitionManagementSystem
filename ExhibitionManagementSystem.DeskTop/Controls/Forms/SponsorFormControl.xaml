<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Controls.Forms.SponsorFormControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="450"
             FlowDirection="RightToLeft">
    <Border Background="White" CornerRadius="12" Padding="24">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource H2Style}" Margin="0,0,0,16"/>

            <!-- Company Name -->
            <TextBlock Text="اسم الشركة الراعية *" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
            <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                     Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,12"/>

            <!-- Contact Person -->
            <TextBlock Text="مسؤول التواصل" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
            <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                     Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,12"/>

            <!-- Phone & Email Grid -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="رقم الهاتف" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource StandardTextBoxStyle}" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="البريد الإلكتروني" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource StandardTextBoxStyle}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>

            <!-- Website & Logo URL -->
            <TextBlock Text="الموقع الإلكتروني" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
            <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                     Text="{Binding WebsiteUrl, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,12"/>

            <TextBlock Text="رابط شعار الشركة (Logo URL)" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
            <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                     Text="{Binding LogoUrl, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,12"/>

            <!-- Profile Notes -->
            <TextBlock Text="نبذة تعريفية عن الراعي" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
            <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                     Text="{Binding CompanyProfile, UpdateSourceTrigger=PropertyChanged}" 
                     Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                     Margin="0,0,0,16"/>

            <!-- Actions -->
            <Button Content="حفظ البيانات" 
                    Style="{StaticResource PrimaryButtonStyle}" 
                    Command="{Binding SaveCommand}" 
                    Height="40"/>
        </StackPanel>
    </Border>
</UserControl>
