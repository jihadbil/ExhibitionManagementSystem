<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Controls.Forms.UserFormControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="680" d:DesignHeight="550"
             FlowDirection="RightToLeft">
    <Grid Margin="0" MinWidth="640">
        <Grid.RowDefinitions>
            <!-- Form Scroll Content -->
            <RowDefinition Height="*"/>
            <!-- Footer Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,20">
            <StackPanel Margin="0,0,4,0">
                
                <Border Style="{StaticResource FormGroupCardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="👤 بيانات المستخدم وتصريح الدخول" Style="{StaticResource FormSectionHeaderStyle}" Margin="0,0,0,16"/>

                        <!-- FullName -->
                        <TextBlock Style="{StaticResource LabelStyle}" Margin="0,0,0,8">
                            <Run Text="الاسم الكامل "/><Run Text="*" Foreground="{StaticResource DangerBrush}"/>
                        </TextBlock>
                        <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                 Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" 
                                 Tag="أدخل الاسم الثلاثي للمستخدم"
                                 IsEnabled="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                                 Margin="0,0,0,18"/>

                        <!-- Email -->
                        <TextBlock Style="{StaticResource LabelStyle}" Margin="0,0,0,8">
                            <Run Text="البريد الإلكتروني "/><Run Text="*" Foreground="{StaticResource DangerBrush}"/>
                        </TextBlock>
                        <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                                 Tag="user@domain.com"
                                 IsEnabled="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                                 Margin="0,0,0,18"/>

                        <!-- Initial Password (only visible when creating new user) -->
                        <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                            <TextBlock Style="{StaticResource LabelStyle}" Margin="0,0,0,8">
                                <Run Text="كلمة المرور الأولية "/><Run Text="*" Foreground="{StaticResource DangerBrush}"/>
                            </TextBlock>
                            <PasswordBox x:Name="PasswordBoxInput" 
                                         Style="{StaticResource StandardPasswordBoxStyle}" 
                                         Margin="0,0,0,18"/>
                        </StackPanel>

                        <!-- Assigned Role -->
                        <TextBlock Style="{StaticResource LabelStyle}" Margin="0,0,0,8">
                            <Run Text="الدور الوظيفي المُعيَّن "/><Run Text="*" Foreground="{StaticResource DangerBrush}"/>
                        </TextBlock>
                        <ComboBox Style="{StaticResource StandardComboBoxStyle}"
                                  ItemsSource="{Binding AvailableRoles}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Name"
                                  SelectedValue="{Binding SelectedRoleName}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderMainBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="✓ حفظ المستخدم" 
                        Command="{Binding SaveCommand}" 
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Grid.Column="1" 
                        Width="160" Height="48"
                        Margin="0,0,14,0"/>
                <Button Content="✕ إلغاء" 
                        Command="{Binding CancelCommand}" 
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Grid.Column="2" 
                        Width="120" Height="48"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
