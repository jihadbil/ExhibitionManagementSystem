<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Controls.Forms.HallFormControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="680" d:DesignHeight="550"
             FlowDirection="RightToLeft">
    <Grid Margin="0" MinWidth="640">
        <Grid.RowDefinitions>
            <!-- Form Fields Area -->
            <RowDefinition Height="*"/>
            <!-- Footer Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,20">
            <StackPanel Margin="0,0,4,0">
                
                <Border Style="{StaticResource FormGroupCardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="🏛️ بيانات ومعايير القاعة" Style="{StaticResource FormSectionHeaderStyle}" Margin="0,0,0,16"/>

                        <!-- HallName -->
                        <TextBlock Style="{StaticResource LabelStyle}" Margin="0,0,0,8">
                            <Run Text="اسم القاعة "/><Run Text="*" Foreground="{StaticResource DangerBrush}"/>
                        </TextBlock>
                        <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                 Text="{Binding HallName, UpdateSourceTrigger=PropertyChanged}" 
                                 Tag="مثال: القاعة الرئيسية (A1)"
                                 Margin="0,0,0,18"/>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- AreaSqM -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="المساحة (م²)" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                         Text="{Binding AreaSqM, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" 
                                         Tag="مثال: 1200"/>
                            </StackPanel>

                            <!-- MaxBooths -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="الحد الأقصى للأجنحة" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                         Text="{Binding MaxBooths, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" 
                                         Tag="مثال: 50"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- FloorPlanWidth -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="عرض المخطط (بكسل)" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                         Text="{Binding FloorPlanWidth, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" 
                                         Tag="1920"/>
                            </StackPanel>

                            <!-- FloorPlanHeight -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ارتفاع المخطط (بكسل)" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                         Text="{Binding FloorPlanHeight, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" 
                                         Tag="1080"/>
                            </StackPanel>
                        </Grid>

                        <!-- IsActive (Only editable in edit mode) -->
                        <StackPanel Margin="0,18,0,0" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox Content="القاعة نشطة ومتاحة للاستخدام الحجز" 
                                      IsChecked="{Binding IsActive}" 
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      FontSize="14"
                                      FontFamily="{StaticResource WorkSansMedium}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderMainBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="✓ حفظ القاعة" 
                        Command="{Binding SaveCommand}" 
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Grid.Column="1" 
                        Width="160" Height="48"
                        Margin="0,0,14,0"/>
                <Button Content="✕ إلغاء" 
                        Command="{Binding CancelCommand}" 
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Grid.Column="2" 
                        Width="120" Height="48"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
