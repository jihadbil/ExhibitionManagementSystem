<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Controls.Forms.PackageFormControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="520" d:DesignWidth="680"
             FlowDirection="RightToLeft">
    <Grid Margin="0" MinWidth="640">
        <Grid.RowDefinitions>
            <!-- Form Content -->
            <RowDefinition Height="*"/>
            <!-- Footer Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,20">
            <StackPanel Margin="0,0,4,0">
                
                <Border Style="{StaticResource FormGroupCardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="📦 تفاصيل وسعر الباقة" Style="{StaticResource FormSectionHeaderStyle}" Margin="0,0,0,16"/>

                        <!-- Name -->
                        <TextBlock Style="{StaticResource LabelStyle}" Margin="0,0,0,8">
                            <Run Text="اسم الباقة "/><Run Text="*" Foreground="{StaticResource DangerBrush}"/>
                        </TextBlock>
                        <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                 Text="{Binding NewPackageName, UpdateSourceTrigger=PropertyChanged}" 
                                 Tag="مثال: الباقة الذهبية للرعاية والتجهيز"
                                 Margin="0,0,0,18"/>

                        <!-- Description -->
                        <TextBlock Text="الوصف والمميزات" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                 Text="{Binding NewPackageDescription, UpdateSourceTrigger=PropertyChanged}" 
                                 AcceptsReturn="True" Height="80" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 Tag="أدخل تفاصيل الخدمات والامتيازات المشمولة..."
                                 Margin="0,0,0,18"/>

                        <!-- Price -->
                        <TextBlock Style="{StaticResource LabelStyle}" Margin="0,0,0,8">
                            <Run Text="السعر الإجمالي للباقة "/><Run Text="*" Foreground="{StaticResource DangerBrush}"/>
                        </TextBlock>
                        <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                 Text="{Binding NewPackagePrice, UpdateSourceTrigger=PropertyChanged}" 
                                 Tag="0.00"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderMainBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
            <Button Content="✓ حفظ وإدراج الباقة" 
                    Style="{StaticResource PrimaryButtonStyle}" 
                    Command="{Binding SavePackageCommand}" 
                    Height="48" 
                    HorizontalAlignment="Stretch"/>
        </Border>
    </Grid>
</UserControl>
