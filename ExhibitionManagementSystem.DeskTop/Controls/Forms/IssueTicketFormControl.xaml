<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Controls.Forms.IssueTicketFormControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="680"
             FlowDirection="RightToLeft">
    <Grid Margin="0" MinWidth="640">
        <Grid.RowDefinitions>
            <!-- Form Content -->
            <RowDefinition Height="*"/>
            <!-- Footer Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,20">
            <StackPanel Margin="0,0,4,0">
                
                <Border Style="{StaticResource FormGroupCardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="🎟️ تفاصيل تذكرة المعرض" Style="{StaticResource FormSectionHeaderStyle}" Margin="0,0,0,16"/>

                        <!-- Select Visitor -->
                        <TextBlock Style="{StaticResource LabelStyle}" Margin="0,0,0,8">
                            <Run Text="اختر الزائر "/><Run Text="*" Foreground="{StaticResource DangerBrush}"/>
                        </TextBlock>
                        <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                                  ItemsSource="{Binding Visitors}" 
                                  SelectedValuePath="VisitorID" 
                                  DisplayMemberPath="FullName" 
                                  SelectedValue="{Binding SelectedVisitorId}"
                                  Margin="0,0,0,18"/>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Ticket Type -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="فئة التذكرة" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                                          ItemsSource="{Binding TicketTypes}" 
                                          SelectedItem="{Binding SelectedTicketType}"/>
                            </StackPanel>

                            <!-- Price -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource LabelStyle}" Margin="0,0,0,8">
                                    <Run Text="السعر "/><Run Text="*" Foreground="{StaticResource DangerBrush}"/>
                                </TextBlock>
                                <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                         Text="{Binding NewTicketPrice, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="0.00"/>
                            </StackPanel>
                        </Grid>

                        <!-- Currency Code -->
                        <TextBlock Text="رمز العملة" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                 Text="{Binding NewTicketCurrencyCode, UpdateSourceTrigger=PropertyChanged}" 
                                 Tag="SAR / USD"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderMainBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
            <Button Content="✓ إصدار وتأكيد التذكرة 🎟️" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding IssueTicketCommand}"
                    Height="48"
                    HorizontalAlignment="Stretch"/>
        </Border>
    </Grid>
</UserControl>

