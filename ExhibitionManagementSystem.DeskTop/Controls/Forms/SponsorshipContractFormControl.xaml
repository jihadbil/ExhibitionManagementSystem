<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Controls.Forms.SponsorshipContractFormControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="500"
             FlowDirection="RightToLeft">
    <Border Background="White" CornerRadius="12" Padding="24">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource H2Style}" Margin="0,0,0,16"/>

            <!-- Sponsor Selection -->
            <TextBlock Text="الراعي (الشركة الراعية) *" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
            <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                      ItemsSource="{Binding Sponsors}" 
                      SelectedValuePath="SponsorID" 
                      DisplayMemberPath="CompanyName" 
                      SelectedValue="{Binding SelectedSponsorId}"
                      Margin="0,0,0,12"/>

            <!-- Package Selection & Contract Number -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="باقة الرعاية" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                              ItemsSource="{Binding Packages}" 
                              SelectedValuePath="PackageID" 
                              DisplayMemberPath="PackageName" 
                              SelectedValue="{Binding SelectedPackageId}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="رقم العقد" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource StandardTextBoxStyle}" Text="{Binding ContractNumber, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>

            <!-- Total Amount & Due Date -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="إجمالي مبلغ العقد *" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource StandardTextBoxStyle}" Text="{Binding TotalAmount, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="تاريخ استحقاق السداد" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding PaymentDueDate}"/>
                </StackPanel>
            </Grid>

            <!-- Special Terms & Notes -->
            <TextBlock Text="الشروط الخاصة بالعقد والملاحظات" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
            <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                     Text="{Binding SpecialTerms, UpdateSourceTrigger=PropertyChanged}" 
                     Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                     Margin="0,0,0,16"/>

            <!-- Actions -->
            <Button Content="توثيق وإنشاء عقد الرعاية" 
                    Style="{StaticResource PrimaryButtonStyle}" 
                    Command="{Binding SaveCommand}" 
                    Height="40"/>
        </StackPanel>
    </Border>
</UserControl>
