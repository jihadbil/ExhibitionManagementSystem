<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Controls.Forms.ServiceFormControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="520" d:DesignWidth="680"
             FlowDirection="RightToLeft">
    <Grid Margin="0" MinWidth="640">
        <Grid.RowDefinitions>
            <!-- Form Content -->
            <RowDefinition Height="*"/>
            <!-- Footer Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,20">
            <StackPanel Margin="0,0,4,0">
                
                <Border Style="{StaticResource FormGroupCardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="🛠️ بيانات الخدمة الإضافية" Style="{StaticResource FormSectionHeaderStyle}" Margin="0,0,0,16"/>

                        <!-- Name -->
                        <TextBlock Style="{StaticResource LabelStyle}" Margin="0,0,0,8">
                            <Run Text="اسم الخدمة "/><Run Text="*" Foreground="{StaticResource DangerBrush}"/>
                        </TextBlock>
                        <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                 Text="{Binding NewServiceName, UpdateSourceTrigger=PropertyChanged}" 
                                 Tag="مثال: توصيل كهرباء قدرة 5 كيلوواط"
                                 Margin="0,0,0,18"/>

                        <!-- Description -->
                        <TextBlock Text="الوصف والتفاصيل" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                 Text="{Binding NewServiceDescription, UpdateSourceTrigger=PropertyChanged}" 
                                 AcceptsReturn="True" Height="80" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 Tag="أدخل تفاصيل ومواصفات الخدمة..."
                                 Margin="0,0,0,18"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Base Price -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelStyle}" Margin="0,0,0,8">
                                    <Run Text="السعر الافتراضي "/><Run Text="*" Foreground="{StaticResource DangerBrush}"/>
                                </TextBlock>
                                <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                         Text="{Binding NewServiceBasePrice, UpdateSourceTrigger=PropertyChanged}" 
                                         Tag="0.00"/>
                            </StackPanel>

                            <!-- Service Unit -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="الوحدة" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                                          ItemsSource="{Binding ServiceUnits}" 
                                          SelectedItem="{Binding NewServiceUnit}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderMainBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
            <Button Content="✓ حفظ وإضافة الخدمة" 
                    Style="{StaticResource PrimaryButtonStyle}" 
                    Command="{Binding SaveServiceCommand}" 
                    Height="48" 
                    HorizontalAlignment="Stretch"/>
        </Border>
    </Grid>
</UserControl>
