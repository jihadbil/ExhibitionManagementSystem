<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Controls.Forms.ExhibitorFormControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="720" d:DesignHeight="660"
             FlowDirection="RightToLeft">
    <Grid Margin="0" MinWidth="680">
        <Grid.RowDefinitions>
            <!-- Form Scroll Content -->
            <RowDefinition Height="*"/>
            <!-- Footer Divider & Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,20">
            <StackPanel Margin="0,0,4,0">
                
                <!-- Section 1: Company Info Card -->
                <Border Style="{StaticResource FormGroupCardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="🏢 معلومات الشركة والنشاط" Style="{StaticResource FormSectionHeaderStyle}" Margin="0,0,0,16"/>
                        
                        <!-- Company Name -->
                        <TextBlock Style="{StaticResource LabelStyle}" Margin="0,0,0,8">
                            <Run Text="اسم الشركة العارضة "/><Run Text="*" Foreground="{StaticResource DangerBrush}"/>
                        </TextBlock>
                        <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                 Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" 
                                 Tag="أدخل اسم الشركة العارضة الكامل"
                                 Margin="0,0,0,18"/>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sector -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="قطاع العمل" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                         Text="{Binding Sector, UpdateSourceTrigger=PropertyChanged}" 
                                         Tag="مثال: تكنولوجيا، صناعة..."/>
                            </StackPanel>

                            <!-- Category -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="فئة العارض" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                                          ItemsSource="{Binding ExhibitorCategories}" 
                                          SelectedItem="{Binding ExhibitorCategory}"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Nationality -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="الجنسية / البلد" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                         Text="{Binding Nationality, UpdateSourceTrigger=PropertyChanged}" 
                                         Tag="مثال: المملكة العربية السعودية"/>
                            </StackPanel>

                            <!-- Logo URL -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="رابط شعار الشركة (Logo URL)" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                         Text="{Binding LogoURL, UpdateSourceTrigger=PropertyChanged}" 
                                         Tag="https://..."/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 2: Contact Info & Profile Card -->
                <Border Style="{StaticResource FormGroupCardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="👤 بيانات المسؤول والتواصل" Style="{StaticResource FormSectionHeaderStyle}" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Contact Person -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="اسم المسؤول عن الاتصال" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                         Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" 
                                         Tag="اسم الشخص المسؤول"/>
                            </StackPanel>

                            <!-- Email -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="البريد الإلكتروني" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                                         Tag="name@company.com"/>
                            </StackPanel>
                        </Grid>

                        <!-- Phone -->
                        <TextBlock Text="رقم الهاتف" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                 Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" 
                                 Tag="+966 5x xxx xxxx"
                                 Margin="0,0,0,18"/>

                        <!-- Profile -->
                        <TextBlock Text="ملف تعريف الشركة (نبذة مختصرة)" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                 Text="{Binding CompanyProfile, UpdateSourceTrigger=PropertyChanged}" 
                                 AcceptsReturn="True" Height="80" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 Tag="أدخل نبذة تعريفيّة موجزة عن أنشطة الشركة..."/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderMainBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="✓ حفظ الشركة" 
                        Command="{Binding SaveCommand}" 
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Grid.Column="1" 
                        Width="160" Height="48"
                        Margin="0,0,14,0"/>
                <Button Content="✕ إلغاء" 
                        Command="{Binding CancelCommand}" 
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Grid.Column="2" 
                        Width="120" Height="48"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
