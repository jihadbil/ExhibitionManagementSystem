<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Controls.Cards.StatCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="140" d:DesignWidth="250">
    <Border Style="{StaticResource StandardCardStyle}" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title and Value -->
            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleLabel"
                           Text="العنوان"
                           Style="{StaticResource LabelStyle}"
                           FontSize="13"
                           Margin="0,0,0,4"/>
                <TextBlock x:Name="ValueLabel"
                           Text="0"
                           FontFamily="{StaticResource WorkSansBold}"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>

            <!-- Icon Container -->
            <Border Grid.Row="0" Grid.Column="1"
                    x:Name="IconBorder"
                    Width="48" Height="48"
                    CornerRadius="24"
                    Background="{StaticResource BgSecondaryBrush}"
                    VerticalAlignment="Center">
                <TextBlock x:Name="IconLabel"
                           Text="📊"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Trend Section -->
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock x:Name="TrendIcon"
                           Text="▲"
                           FontWeight="Bold"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"/>
                <TextBlock x:Name="TrendTextLabel"
                           Text="+0%"
                           FontFamily="{StaticResource WorkSansMedium}"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
