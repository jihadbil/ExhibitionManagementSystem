<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Controls.Cards.ExhibitionCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:badges="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Badges"
             mc:Ignorable="d" 
             x:Name="Root"
             d:DesignHeight="250" d:DesignWidth="300">
    <Border Style="{StaticResource StandardCardStyle}" Padding="0" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Top Accent Gradient Bar (10px) -->
                <RowDefinition Height="10"/>
                <!-- Card Content -->
                <RowDefinition Height="*"/>
                <!-- Footer Action Buttons -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Gradient Accent -->
            <Border Grid.Row="0" Background="{Binding Type, ElementName=Root, Converter={StaticResource TypeToGradient}}"/>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: Emoji & Name -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Path x:Name="TypeIcon" Grid.Column="0" Width="24" Height="24" Stretch="Uniform" Fill="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="{StaticResource IconExhibition}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Type, ElementName=Root}" Value="Tech">
                                        <Setter Property="Data" Value="{StaticResource IconTech}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type, ElementName=Root}" Value="Medical">
                                        <Setter Property="Data" Value="{StaticResource IconMedical}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type, ElementName=Root}" Value="Industrial">
                                        <Setter Property="Data" Value="{StaticResource IconIndustrial}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type, ElementName=Root}" Value="Commercial">
                                        <Setter Property="Data" Value="{StaticResource IconCommercial}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type, ElementName=Root}" Value="Educational">
                                        <Setter Property="Data" Value="{StaticResource IconEducational}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type, ElementName=Root}" Value="Automotive">
                                        <Setter Property="Data" Value="{StaticResource IconAutomotive}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <TextBlock Text="{Binding ExhibitionName, ElementName=Root}"
                               FontFamily="{StaticResource WorkSansBold}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"/>
                    <badges:StatusBadgeControl Grid.Column="2" Status="{Binding Status, ElementName=Root}" VerticalAlignment="Center"/>
                </Grid>

                <!-- Details (Date & Venue) -->
                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Path Data="{StaticResource IconCalendar}" Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock FontFamily="{StaticResource WorkSansRegular}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource DateRangeConverter}">
                                    <Binding Path="StartDate" ElementName="Root"/>
                                    <Binding Path="EndDate" ElementName="Root"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconLocation}" Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding VenueName, ElementName=Root}"
                                   FontFamily="{StaticResource WorkSansRegular}"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Type Label -->
                <TextBlock Grid.Row="2"
                           x:Name="TypeLabel"
                           Text="المعرض"
                           FontFamily="{StaticResource WorkSansMedium}"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </Grid>

            <!-- Footer Action Buttons -->
            <Border Grid.Row="2" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderMainBrush}" BorderThickness="0,1,0,0" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="حذف"
                            Style="{StaticResource DangerButtonStyle}"
                            Padding="12,6"
                            Height="32"
                            Grid.Column="0"
                            Click="Delete_Click"/>

                    <ComboBox Width="110" Height="32" Margin="8,0"
                              x:Name="StatusCombo"
                              Grid.Column="1"
                              SelectionChanged="StatusCombo_SelectionChanged"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="Upcoming" Tag="Upcoming"/>
                        <ComboBoxItem Content="Open" Tag="Open"/>
                        <ComboBoxItem Content="Closed" Tag="Closed"/>
                        <ComboBoxItem Content="Cancelled" Tag="Cancelled"/>
                    </ComboBox>

                    <Button Content="تعديل"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,6"
                            Height="32"
                            Grid.Column="2"
                            Click="Edit_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
