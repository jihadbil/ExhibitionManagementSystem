<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Controls.Cards.ExhibitionCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:badges="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Badges"
             mc:Ignorable="d" 
             x:Name="Root"
             d:DesignHeight="250" d:DesignWidth="300">
    <Border Style="{StaticResource StandardCardStyle}" Padding="0" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Top Accent Gradient Bar (10px) -->
                <RowDefinition Height="10"/>
                <!-- Card Content -->
                <RowDefinition Height="*"/>
                <!-- Footer Action Buttons -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Gradient Accent -->
            <Border Grid.Row="0" Background="{Binding Type, ElementName=Root, Converter={StaticResource TypeToGradient}}"/>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: Emoji & Name -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="EmojiText" Grid.Column="0" Text="🏛️" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ExhibitionName, ElementName=Root}"
                               FontFamily="{StaticResource WorkSansBold}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"/>
                    <badges:StatusBadgeControl Grid.Column="2" Status="{Binding Status, ElementName=Root}" VerticalAlignment="Center"/>
                </Grid>

                <!-- Details (Date & Venue) -->
                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="📅" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock FontFamily="{StaticResource WorkSansRegular}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource DateRangeConverter}">
                                    <Binding Path="StartDate" ElementName="Root"/>
                                    <Binding Path="EndDate" ElementName="Root"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📍" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding VenueName, ElementName=Root}"
                                   FontFamily="{StaticResource WorkSansRegular}"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Type Label -->
                <TextBlock Grid.Row="2"
                           x:Name="TypeLabel"
                           Text="المعرض"
                           FontFamily="{StaticResource WorkSansMedium}"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </Grid>

            <!-- Footer Action Buttons -->
            <Border Grid.Row="2" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderMainBrush}" BorderThickness="0,1,0,0" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="تعديل"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="16,6"
                            Height="32"
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            Click="Edit_Click"
                            Margin="0,0,8,0"/>
                    <Button Content="حذف"
                            Style="{StaticResource DangerButtonStyle}"
                            Padding="16,6"
                            Height="32"
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            Click="Delete_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
