<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Controls.Badges.CategoryBadgeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             x:Name="Root">
    <Border x:Name="BadgeBorder" Padding="8,4" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="BadgeText" FontSize="11" FontFamily="{StaticResource WorkSansMedium}" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
</UserControl>
