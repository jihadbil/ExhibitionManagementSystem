<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Controls.Feedback.EmptyStateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             x:Name="Root"
             d:DesignHeight="300" d:DesignWidth="500">
    <Border Style="{StaticResource StandardCardStyle}" Padding="40" Background="{StaticResource BgSecondaryBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Icon Path (big, muted) -->
            <Path Data="{Binding IconGeometry, ElementName=Root}"
                  Width="48" Height="48"
                  Stretch="Uniform"
                  Fill="{StaticResource TextMutedBrush}"
                  HorizontalAlignment="Center" 
                  Margin="0,0,0,16"/>
            <!-- Title -->
            <TextBlock Text="{Binding Title, ElementName=Root}"
                       Style="{StaticResource H2Style}"
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,8"/>
            <!-- Description -->
            <TextBlock Text="{Binding Description, ElementName=Root}"
                       Style="{StaticResource BodySecondaryStyle}"
                       TextAlignment="Center" 
                       MaxWidth="350" 
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
