<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Controls.Notifications.ToastNotificationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="350"
             Opacity="0"
             Visibility="Collapsed">
    <Border x:Name="ToastBorder"
            Background="White"
            BorderThickness="0,0,6,0"
            CornerRadius="12"
            Width="350"
            Padding="16"
            Margin="0,0,0,10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="2" Opacity="0.12"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Icon -->
            <TextBlock x:Name="IconText"
                       Grid.Column="0"
                       FontSize="20"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       Text="✓"/>

            <!-- Content -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           FontFamily="{StaticResource WorkSansBold}"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="نجاح"
                           Margin="0,0,0,2"/>
                <TextBlock x:Name="MessageText"
                           FontFamily="{StaticResource WorkSansRegular}"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Text="تمت العملية بنجاح."/>
            </StackPanel>

            <!-- Close Button -->
            <Button Grid.Column="2"
                    Style="{StaticResource IconButtonStyle}"
                    Width="24"
                    Height="24"
                    Click="CloseButton_Click"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Margin="8,0,0,0">
                <TextBlock Text="✕" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
