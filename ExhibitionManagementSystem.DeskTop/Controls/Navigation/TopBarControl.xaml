<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Controls.Navigation.TopBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="64" d:DesignWidth="800"
             Background="White">
    <Border BorderBrush="{StaticResource BorderMainBrush}" BorderThickness="0,0,0,1" Height="64">
        <Grid Margin="24,0">
            <Grid.ColumnDefinitions>
                <!-- Right column: Current Page Title -->
                <ColumnDefinition Width="Auto"/>
                <!-- Middle column: Search -->
                <ColumnDefinition Width="*"/>
                <!-- Left column: Profile / Notifications -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Page Title with Breadcrumb -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                <TextBlock Text="ExpoManager" Style="{StaticResource BodySecondaryStyle}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="/" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="PageTitleText"
                           FontFamily="{StaticResource WorkSansBold}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Text="لوحة التحكم"/>
            </StackPanel>

            <!-- Search Bar (Stub placeholder - Collapsed to avoid UX confusion) -->
            <Grid Grid.Column="1" HorizontalAlignment="Center" Width="400" MaxWidth="400" Height="38" Visibility="Collapsed">
                <TextBox Style="{StaticResource StandardTextBoxStyle}"
                         Padding="16,0"
                         Height="38"
                         Tag="ابحث عن أي شيء..."
                         VerticalAlignment="Center"/>
            </Grid>

            <!-- Profile and Options -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Notifications Bell -->
                <Button Style="{StaticResource IconButtonStyle}" Margin="0,0,8,0">
                    <Path Data="{StaticResource IconNotification}"
                          Width="16" Height="16"
                          Stretch="Uniform"
                          Fill="{StaticResource TextSecondaryBrush}"/>
                </Button>

                <!-- Settings Gear -->
                <Button Style="{StaticResource IconButtonStyle}" Margin="0,0,16,0" Click="Settings_Click">
                    <Path Data="{StaticResource IconSettings}"
                          Width="16" Height="16"
                          Stretch="Uniform"
                          Fill="{StaticResource TextSecondaryBrush}"/>
                </Button>

                <!-- User Initial Badge -->
                <Border Background="{StaticResource PrimaryGradientBrush}"
                        Width="36"
                        Height="36"
                        CornerRadius="18"
                        VerticalAlignment="Center"
                        ToolTip="{Binding Path=FullName, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <TextBlock x:Name="UserInitialsText"
                               Text="م"
                               FontFamily="{StaticResource WorkSansBold}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
