<Window x:Class="ExhibitionManagementSystem.DeskTop.Views.Shell.MainShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nav="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Navigation"
        xmlns:notif="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Notifications"
        Title="ExpoManager — نظام إدارة المعارض"
        WindowState="Maximized"
        Background="{StaticResource BgMainBrush}"
        FlowDirection="RightToLeft"
        Loaded="MainShellWindow_Loaded"
        WindowStartupLocation="CenterScreen"
        MinHeight="700" MinWidth="1100">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <nav:SidebarControl Grid.Column="0" x:Name="Sidebar"/>

        <!-- Content Area -->
        <DockPanel Grid.Column="1">
            <nav:TopBarControl DockPanel.Dock="Top" x:Name="TopBar" Height="64"/>
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
        </DockPanel>

        <!-- Toast Overlay -->
        <notif:ToastNotificationControl x:Name="ToastHost"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="16,80,0,0"
            Panel.ZIndex="999"/>
    </Grid>
</Window>
