<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Views.Companies.CompaniesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             FlowDirection="RightToLeft">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <!-- Header Title -->
            <RowDefinition Height="Auto"/>
            <!-- Search Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Companies DataGrid -->
            <RowDefinition Height="*"/>
            <!-- Pagination -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="إدارة الشركات العارضة" Style="{StaticResource H1Style}" Margin="0,0,0,24"/>

        <!-- Search Bar -->
        <Border Grid.Row="1" Style="{StaticResource StandardCardStyle}" Padding="16" Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         Grid.Column="0"
                         VerticalContentAlignment="Center"
                         Tag="ابحث عن شركة باسم الشركة، المجال، أو الجنسية..."/>

                <Button Style="{StaticResource PrimaryButtonStyle}" 
                        Command="{Binding SearchCommand}"
                        Content="🔍 بحث" 
                        Grid.Column="2"
                        Width="120" Height="48"/>
            </Grid>
        </Border>

        <!-- Companies DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource StandardCardStyle}" Padding="16" Margin="0,0,0,20">
            <DataGrid ItemsSource="{Binding Companies}"
                      Style="{StaticResource AppDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource AppDataGridColumnHeaderStyle}"
                      RowStyle="{StaticResource AppDataGridRowStyle}"
                      CellStyle="{StaticResource AppDataGridCellStyle}"
                      AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="اسم الشركة" Binding="{Binding CompanyName}" Width="2*"/>
                    <DataGridTextColumn Header="قطاع العمل / المجال" Binding="{Binding Sector}" Width="1.5*"/>
                    <DataGridTextColumn Header="الجنسية" Binding="{Binding Nationality}" Width="*"/>
                    <DataGridTextColumn Header="فئة العارض" Binding="{Binding ExhibitorCategory}" Width="*"/>
                    
                    <DataGridTemplateColumn Header="الحالة" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="نشط" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="الإجراءات" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="حذف" 
                                        Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding DataContext.DeleteCompanyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding ExhibitorID}"
                                        Padding="12,4" Height="28"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Pagination -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource SecondaryButtonStyle}" 
                    Command="{Binding PrevPageCommand}"
                    Content="الصفحة السابقة" 
                    Grid.Column="0"
                    HorizontalAlignment="Right"
                    Width="140"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0">
                <TextBlock Text="الصفحة " Style="{StaticResource BodySecondaryStyle}"/>
                <TextBlock Text="{Binding CurrentPage}" Style="{StaticResource BodyStyle}" FontWeight="Bold"/>
                <TextBlock Text=" من " Style="{StaticResource BodySecondaryStyle}"/>
                <TextBlock Text="{Binding TotalPages}" Style="{StaticResource BodyStyle}" FontWeight="Bold"/>
                <TextBlock Text=" (الإجمالي: " Style="{StaticResource BodySecondaryStyle}"/>
                <TextBlock Text="{Binding TotalCount}" Style="{StaticResource BodyStyle}" FontWeight="Bold"/>
                <TextBlock Text=" عارضين)" Style="{StaticResource BodySecondaryStyle}"/>
            </StackPanel>

            <Button Style="{StaticResource SecondaryButtonStyle}" 
                    Command="{Binding NextPageCommand}"
                    Content="الصفحة التالية" 
                    Grid.Column="2"
                    HorizontalAlignment="Left"
                    Width="140"/>
        </Grid>
    </Grid>
</UserControl>
