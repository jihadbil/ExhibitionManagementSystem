<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Views.Companies.CompaniesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:feedback="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Feedback"
             xmlns:nav="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Navigation"
             xmlns:forms="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Forms"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             FlowDirection="RightToLeft">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <!-- Header Title -->
            <RowDefinition Height="Auto"/>
            <!-- Search Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Companies DataGrid -->
            <RowDefinition Height="*"/>
            <!-- Pagination -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="إدارة الشركات العارضة" Style="{StaticResource H1Style}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <Button Style="{StaticResource PrimaryButtonStyle}" 
                    Click="AddCompany_Click" 
                    Width="160" Height="48" 
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconAdd}" Width="14" Height="14" Stretch="Uniform" Fill="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="شركة جديدة" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Search Bar -->
        <Border Grid.Row="1" Style="{StaticResource StandardCardStyle}" Padding="16" Margin="0,0,0,24">
            <forms:SearchBarControl SearchText="{Binding SearchQuery}"
                                    PlaceholderText="ابحث عن شركة باسم الشركة، المجال، أو الجنسية..."
                                    SearchCommand="{Binding SearchCommand}"/>
        </Border>

        <!-- Companies DataGrid & Empty State -->
        <Border Grid.Row="2" Style="{StaticResource StandardCardStyle}" Padding="16" Margin="0,0,0,20">
            <Grid>
                <DataGrid ItemsSource="{Binding Companies}"
                          Style="{StaticResource AppDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource AppDataGridColumnHeaderStyle}"
                          RowStyle="{StaticResource AppDataGridRowStyle}"
                          CellStyle="{StaticResource AppDataGridCellStyle}"
                          AutoGenerateColumns="False"
                          Visibility="{Binding Companies.Count, Converter={StaticResource InverseCountToVisibility}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="اسم الشركة" Binding="{Binding CompanyName}" Width="2*"/>
                    <DataGridTextColumn Header="قطاع العمل / المجال" Binding="{Binding Sector}" Width="1.5*"/>
                    <DataGridTextColumn Header="الجنسية" Binding="{Binding Nationality}" Width="*"/>
                    <DataGridTextColumn Header="فئة العارض" Binding="{Binding ExhibitorCategory}" Width="*"/>
                    
                    <DataGridTemplateColumn Header="الحالة" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="نشط" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="الإجراءات" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="تعديل" 
                                            Style="{StaticResource SmallSecondaryButtonStyle}"
                                            Click="EditCompany_Click"
                                            Tag="{Binding ExhibitorID}"
                                            Margin="0,0,8,0"/>
                                    <Button Content="حذف" 
                                            Style="{StaticResource SmallDangerButtonStyle}"
                                            Command="{Binding DataContext.DeleteCompanyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding ExhibitorID}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                </DataGrid>

                <feedback:EmptyStateControl 
                    Visibility="{Binding Companies.Count, Converter={StaticResource CountToVisibility}}"
                    IconGeometry="{StaticResource IconCompany}"
                    Title="لا توجد شركات عارضة"
                    Description="لم يتم تسجيل أي شركة عارضة حالياً أو لا توجد نتائج مطابقة لعملية البحث."/>
            </Grid>
        </Border>

        <!-- Pagination -->
        <nav:PaginationControl Grid.Row="3"
                               CurrentPage="{Binding CurrentPage}"
                               TotalPages="{Binding TotalPages}"
                               TotalCount="{Binding TotalCount}"
                               UnitLabel="عارضين"
                               PrevCommand="{Binding PrevPageCommand}"
                               NextCommand="{Binding NextPageCommand}"/>
        
        <!-- Loading Overlay -->
        <feedback:LoadingOverlayControl Grid.Row="0" Grid.RowSpan="4"
                                         IsLoading="{Binding IsBusy}"
                                         Message="جاري تحميل الشركات..."/>
    </Grid>
</UserControl>
