<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Views.Tenants.TenantsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:nav="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Navigation"
             xmlns:badges="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Badges"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             FlowDirection="RightToLeft">
    
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="ملف الشركة العارضة" Style="{StaticResource H1Style}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Edit Form -->
                <ColumnDefinition Width="2*"/>
                <!-- Subscription / Account Details Card -->
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Edit Form Card -->
            <Border Grid.Column="0" Style="{StaticResource StandardCardStyle}" Padding="28" Background="White" Margin="0,0,24,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="تعديل بيانات الشركة الأساسية" Style="{StaticResource H3Style}" Margin="0,0,0,24"/>

                    <!-- Company Name -->
                    <TextBlock Text="اسم الشركة / المؤسسة" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                    <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                             Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="0,0,0,20"/>

                    <!-- Base Currency -->
                    <TextBlock Text="العملة الأساسية للمبيعات والتقارير" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                    <ComboBox Style="{StaticResource StandardComboBoxStyle}"
                              ItemsSource="{Binding Currencies}"
                              SelectedItem="{Binding BaseCurrency}"
                              Margin="0,0,0,28"/>

                    <!-- Operations Buttons -->
                    <Button Style="{StaticResource PrimaryButtonStyle}" 
                            Command="{Binding SaveTenantCommand}" 
                            Height="48" Width="200" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSave}" Width="14" Height="14" Stretch="Uniform" Fill="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="حفظ التغييرات" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Subscription Card -->
            <Border Grid.Column="1" Style="{StaticResource StandardCardStyle}" Padding="24" Background="White" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="تفاصيل الاشتراك والنظام" Style="{StaticResource H3Style}" Margin="0,0,0,20"/>

                    <!-- Subdomain (Platform URL/Domain) -->
                    <TextBlock Text="النطاق الفرعي (Subdomain)" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                             Text="{Binding Subdomain}" 
                             IsEnabled="False"
                             Margin="0,0,0,16"/>

                    <!-- Current Plan -->
                    <TextBlock Text="الباقة المفعلة حالياً" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                             Text="{Binding Plan}" 
                             IsEnabled="False"
                             Margin="0,0,0,16"/>

                    <!-- Trial Ends At -->
                    <TextBlock Text="انتهاء الفترة التجريبية" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                             Text="{Binding TrialEndsAt, StringFormat={}{0:dd/MM/yyyy}, TargetNullValue='لا يوجد تاريخ انتهاء'}" 
                             IsEnabled="False"
                             Margin="0,0,0,20"/>

                    <Separator Background="{StaticResource BorderMainBrush}" Margin="0,8,0,16" Height="1"/>

                    <!-- Account Status Badge -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="حالة الحساب: " Style="{StaticResource BodySecondaryStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <badges:StatusBadgeControl Status="{Binding IsActive}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
