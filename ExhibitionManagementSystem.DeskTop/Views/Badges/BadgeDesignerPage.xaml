<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Views.Badges.BadgeDesignerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cards="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Cards"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200"
             FlowDirection="RightToLeft">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content Split -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="مصمم وتخصيص الشارات وبطاقات الدخول" Style="{StaticResource H1Style}"/>
                <TextBlock Text="تخصيص قوالب بطاقات الدخول (Badges) بالألوان والشعارات وقواعد الطباعة الحرارية" 
                           Style="{StaticResource BodyMutedStyle}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button Content="+ قالب جديد" 
                        Style="{StaticResource OutlineButtonStyle}" 
                        Command="{Binding CreateNewTemplateCommand}" 
                        Width="120" Height="40" Margin="0,0,12,0"/>
                <Button Content="🖨️ طباعة تجريبية" 
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Command="{Binding TestPrintCurrentDesignCommand}" 
                        Width="140" Height="40"/>
            </StackPanel>
        </Grid>

        <!-- Main Content Split (Left: Designer / Right: Live Preview) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Designer Controls Panel -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Exhibition & Template Selector -->
                    <Border Style="{StaticResource StandardCardStyle}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="تحديد المعرض ونوع المشارك" Style="{StaticResource H3Style}" Margin="0,0,0,16"/>

                            <TextBlock Text="المعرض المستهدف" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                                      ItemsSource="{Binding Exhibitions}" 
                                      SelectedValuePath="ExhibitionID" 
                                      DisplayMemberPath="Name" 
                                      SelectedValue="{Binding SelectedExhibitionId}"
                                      Margin="0,0,0,12"/>

                            <TextBlock Text="نوع المشارك (الفئة) *" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                                      ItemsSource="{Binding ParticipantTypes}" 
                                      SelectedItem="{Binding TargetParticipantType}"
                                      Margin="0,0,0,12"/>

                            <TextBlock Text="اسم القالب *" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                     Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>

                    <!-- Styling & Colors -->
                    <Border Style="{StaticResource StandardCardStyle}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="الألوان والترويسة البصرية" Style="{StaticResource H3Style}" Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="لون الترويسة (HEX)" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource StandardTextBoxStyle}" Text="{Binding HeaderBgColor, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="لون التمييز (Accent)" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource StandardTextBoxStyle}" Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="نص شريط الفئة (Badge Banner Text)" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                     Text="{Binding CategoryBadgeText, UpdateSourceTrigger=PropertyChanged}" 
                                     Margin="0,0,0,12"/>

                            <TextBlock Text="نص التذييل السفلي" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                     Text="{Binding CustomFooterText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>

                    <!-- Field Visibility Toggles -->
                    <Border Style="{StaticResource StandardCardStyle}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="الحقول والعناصر المعروضة" Style="{StaticResource H3Style}" Margin="0,0,0,16"/>

                            <CheckBox Content="إظهار رمز الاستجابة السريعة (QR Code)" IsChecked="{Binding ShowQRCode}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                            <CheckBox Content="إظهار اسم الشركة / الجهة" IsChecked="{Binding ShowCompanyName}" Margin="0,0,0,8"/>
                            <CheckBox Content="إظهار المسمى الوظيفي / الدور" IsChecked="{Binding ShowJobTitle}" Margin="0,0,0,8"/>
                            <CheckBox Content="إظهار رقم الجناح والقاعة" IsChecked="{Binding ShowHallName}" Margin="0,0,0,8"/>
                            <CheckBox Content="إظهار تواريخ المعرض" IsChecked="{Binding ShowDates}" Margin="0,0,0,8"/>
                            <CheckBox Content="تعيين هذا القالب كقالب افتراضي لهذه الفئة" IsChecked="{Binding IsDefault}" Margin="0,8,0,0" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Actions -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="💾 حفظ وتطبيق القالب" 
                                Style="{StaticResource PrimaryButtonStyle}" 
                                Command="{Binding SaveTemplateCommand}" 
                                Height="44"/>

                        <Button Grid.Column="2" Content="🗑️ حذف" 
                                Style="{StaticResource DangerButtonStyle}" 
                                Command="{Binding DeleteTemplateCommand}" 
                                Width="80" Height="44"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT: Live Preview Card Area -->
            <Border Grid.Column="2" Style="{StaticResource StandardCardStyle}" Padding="32" Background="#F8FAFC">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="معاينة حية وتفاعلية لبطاقة الدخول (Live Badge Preview)" 
                               Style="{StaticResource H2Style}" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                    <!-- BADGE CONTAINER SIMULATION (Realistic CR80 / Thermal Preview) -->
                    <Viewbox Grid.Row="1" MaxWidth="360" MaxHeight="520" Stretch="Uniform">
                        <Border Width="340" Height="480" Background="White" CornerRadius="16" BorderBrush="#CBD5E1" BorderThickness="1.5">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="6" Opacity="0.15"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- Header Banner -->
                                    <RowDefinition Height="90"/>
                                    <!-- Main Body -->
                                    <RowDefinition Height="*"/>
                                    <!-- Bottom Footer -->
                                    <RowDefinition Height="45"/>
                                </Grid.RowDefinitions>

                                <!-- Top Header Banner -->
                                <Border Grid.Row="0" CornerRadius="14,14,0,0" Padding="16,12" Background="#6366F1">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CategoryBadgeText}" 
                                                   Foreground="White" FontSize="18" FontWeight="Bold" 
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding SampleExhibitionName}" 
                                                   Foreground="#E0E7FF" FontSize="11" FontWeight="Medium" 
                                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Body Details -->
                                <StackPanel Grid.Row="1" Margin="20,16,20,12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Attendee Full Name -->
                                    <TextBlock Text="{Binding SampleAttendeeName}" 
                                               FontSize="20" FontWeight="Bold" Foreground="#1E293B" 
                                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,6"/>

                                    <!-- Company Name -->
                                    <TextBlock Text="{Binding SampleCompanyName}" 
                                               FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" 
                                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,4"/>

                                    <!-- Job Title -->
                                    <TextBlock Text="{Binding SampleJobTitle}" 
                                               FontSize="12" Foreground="#64748B" 
                                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,12"/>

                                    <!-- QR Code Graphic Container -->
                                    <Border Width="130" Height="130" Background="#F1F5F9" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1.5" Margin="0,4,0,10">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="📷 QR CODE" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding SampleQRCode}" FontSize="9" FontFamily="Consolas" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Hall & Booth info -->
                                    <TextBlock Text="{Binding SampleLocation}" 
                                               FontSize="11" FontWeight="Medium" Foreground="#475569" 
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Bottom Footer -->
                                <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,14,14" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,6">
                                    <Grid>
                                        <TextBlock Text="{Binding CustomFooterText}" 
                                                   FontSize="10" Foreground="#64748B" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Viewbox>

                    <!-- Preview Controls Info -->
                    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16" Margin="0,16,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="💡 نصيحة الطباعة الحرارية المباشرة" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,2"/>
                                <TextBlock Text="القوالب متوافقة مع كافة طابعات الشارات الحرارية (Zebra, Dymo, Brother) وبطاقات PVC القياسية." 
                                           FontSize="11" Foreground="#64748B"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="🖨️ طباعة الشارة الحالية" 
                                    Style="{StaticResource PrimaryButtonStyle}" 
                                    Command="{Binding TestPrintCurrentDesignCommand}" 
                                    Height="36" Width="150"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
