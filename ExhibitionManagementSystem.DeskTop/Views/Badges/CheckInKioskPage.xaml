<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Views.Badges.CheckInKioskPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200"
             FlowDirection="RightToLeft">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <!-- Header & Counters -->
            <RowDefinition Height="Auto"/>
            <!-- Scanner Hero Area & Live Card -->
            <RowDefinition Height="Auto"/>
            <!-- Recent Check-ins -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Kiosk Controls -->
        <Border Grid.Row="0" Style="{StaticResource StandardCardStyle}" Padding="20" Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="كشك الاستقبال والتحقق وطباعة الشارات الفورية" Style="{StaticResource H1Style}"/>
                    <TextBlock Text="مسح تذاكر الزوار والعارضين وطباعة الشارات آلياً في أجزاء من الثانية" 
                               Style="{StaticResource BodyMutedStyle}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Kiosk Controls & Counters -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Exhibition Selector -->
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="المعرض النشط" Style="{StaticResource LabelStyle}" Margin="0,0,0,2"/>
                        <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                                  ItemsSource="{Binding Exhibitions}" 
                                  SelectedValuePath="ExhibitionID" 
                                  DisplayMemberPath="Name" 
                                  SelectedValue="{Binding SelectedExhibitionId}"
                                  Width="180"/>
                    </StackPanel>

                    <!-- Auto-Print Toggle -->
                    <Border Background="#F1F5F9" CornerRadius="8" Padding="12,6" Margin="0,0,16,0" VerticalAlignment="Center">
                        <CheckBox Content="🖨️ طباعة فورية عند المسح" IsChecked="{Binding AutoPrintOnScan}" FontWeight="Bold" Foreground="#1E293B"/>
                    </Border>

                    <!-- Check-in Counter Badge -->
                    <Border Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1.5" CornerRadius="8" Padding="16,8" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="إجمالي الدخول اليوم" FontSize="10" FontWeight="Bold" Foreground="#047857"/>
                            <TextBlock Text="{Binding TodayCheckInCount}" FontSize="20" FontWeight="Bold" Foreground="#065F46" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scanner Hero Section -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- SCANNER INPUT HERO BOX -->
            <Border Grid.Column="0" Style="{StaticResource StandardCardStyle}" Padding="28" Background="#FAFAFC">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📷 مسح رمز الاستجابة السريعة (QR Code / Barcode)" Style="{StaticResource H2Style}" Margin="0,0,0,8"/>
                    <TextBlock Text="وجّه ماسح الباركود نحو تذكرة المشارك أو اكتب الرمز ثم اضغط Enter:" 
                               Style="{StaticResource BodyMutedStyle}" Margin="0,0,0,16"/>

                    <!-- Fast Scanner Input Field -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" 
                                 Style="{StaticResource StandardTextBoxStyle}" 
                                 Text="{Binding ScanInput, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="16" Height="48" Padding="12,8"
                                 KeyDown="ScanTextBox_KeyDown"/>

                        <Button Grid.Column="2" Content="🔍 تحقق ومسح" 
                                Style="{StaticResource PrimaryButtonStyle}" 
                                Command="{Binding ProcessScanCommand}" 
                                Height="48" FontSize="14"/>
                    </Grid>

                    <!-- Status / Feedback Banner -->
                    <Border Background="#EFF6FF" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="8" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ℹ️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold" Foreground="#1E40AF" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- LIVE SCANNED CARD FLASH -->
            <Border Grid.Column="2" Style="{StaticResource StandardCardStyle}" Padding="20" Background="White">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasScannedBadge, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <TextBlock Text="🏷️" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="في انتظار المسح..." Style="{StaticResource H3Style}" HorizontalAlignment="Center"/>
                        <TextBlock Text="ستظهر بطاقة المشارك هنا فور مسح رمزه" Style="{StaticResource BodyMutedStyle}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasScannedBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <!-- Category Banner -->
                        <Border Background="{StaticResource PrimaryBrush}" CornerRadius="8" Padding="12,6" Margin="0,0,0,12">
                            <TextBlock Text="{Binding CurrentBadge.ParticipantTypeTitle}" 
                                       Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Name & Details -->
                        <TextBlock Text="{Binding CurrentBadge.FullName}" FontSize="18" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentBadge.CompanyName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding CurrentBadge.JobTitle}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,8"/>

                        <!-- QR Code & Print Action -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,4,0,12">
                            <TextBlock Text="{Binding CurrentBadge.QRCode}" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center"/>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="🖨️ إعادة الطباعة" 
                                    Style="{StaticResource PrimaryButtonStyle}" 
                                    Command="{Binding PrintCurrentBadgeCommand}" 
                                    Height="38"/>
                            <Button Grid.Column="2" Content="مسح" 
                                    Style="{StaticResource OutlineButtonStyle}" 
                                    Command="{Binding ClearCurrentBadgeCommand}" 
                                    Width="60" Height="38"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- RECENT CHECK-INS TABLE -->
        <Border Grid.Row="2" Style="{StaticResource StandardCardStyle}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="سجل عمليات الدخول والطباعة الأخيرة" Style="{StaticResource H3Style}" Margin="0,0,0,16"/>

                <DataGrid Grid.Row="1" 
                          ItemsSource="{Binding RecentCheckIns}" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          CanUserAddRows="False"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0"
                          Background="Transparent"
                          RowHeight="42">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="2*"/>
                        <DataGridTextColumn Header="الجهة / الشركة" Binding="{Binding CompanyName}" Width="2*"/>
                        <DataGridTextColumn Header="الفئة" Binding="{Binding ParticipantTypeTitle}" Width="1.5*"/>
                        <DataGridTextColumn Header="رمز QR" Binding="{Binding QRCode}" Width="1.5*"/>
                        <DataGridTextColumn Header="وقت الدخول" Binding="{Binding IssuedAt, StringFormat='{}{0:HH:mm:ss}'}" Width="1*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
