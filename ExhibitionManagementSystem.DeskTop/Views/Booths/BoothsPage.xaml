<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Views.Booths.BoothsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:badges="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Badges"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             FlowDirection="RightToLeft">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <!-- Header (Title + Designer Button) -->
            <RowDefinition Height="Auto"/>
            <!-- Filters -->
            <RowDefinition Height="Auto"/>
            <!-- Statistics Cards -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content (Grid + Form Split) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="إدارة الأجنحة" Style="{StaticResource H1Style}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <Button Content="🗺️ المصمم البصري للأجنحة" 
                    Style="{StaticResource PrimaryButtonStyle}" 
                    Command="{Binding OpenDesignerCommand}"
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Left"
                    Width="220" Height="40"/>
        </Grid>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource StandardCardStyle}" Padding="16" Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <!-- Exhibition Select -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="اختر المعرض" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                    <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                              ItemsSource="{Binding Exhibitions}" 
                              SelectedValuePath="ExhibitionID" 
                              DisplayMemberPath="Name" 
                              SelectedValue="{Binding SelectedExhibitionId}"/>
                </StackPanel>

                <!-- Hall Select -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="اختر الصالة" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                    <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                              ItemsSource="{Binding AvailableHalls}" 
                              SelectedValuePath="HallID" 
                              DisplayMemberPath="Name" 
                              SelectedValue="{Binding SelectedHallId}"/>
                </StackPanel>

                <!-- Status Filter -->
                <StackPanel Grid.Column="4">
                    <TextBlock Text="تصفية بالحالة" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                    <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                              ItemsSource="{Binding StatusFilters}" 
                              SelectedItem="{Binding StatusFilter}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Statistics Cards -->
        <Grid Grid.Row="2" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Booths -->
            <Border Grid.Column="0" Style="{StaticResource StandardCardStyle}" Padding="16" Background="White">
                <StackPanel>
                    <TextBlock Text="إجمالي الأجنحة" Style="{StaticResource SmallStyle}" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding TotalCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Available Booths -->
            <Border Grid.Column="2" Style="{StaticResource StandardCardStyle}" Padding="16" Background="White">
                <StackPanel>
                    <TextBlock Text="الأجنحة المتاحة" Style="{StaticResource SmallStyle}" Foreground="{StaticResource SuccessTextBrush}"/>
                    <TextBlock Text="{Binding AvailableCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Reserved Booths -->
            <Border Grid.Column="4" Style="{StaticResource StandardCardStyle}" Padding="16" Background="White">
                <StackPanel>
                    <TextBlock Text="الأجنحة المحجوزة" Style="{StaticResource SmallStyle}" Foreground="{StaticResource InfoTextBrush}"/>
                    <TextBlock Text="{Binding ReservedCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource InfoBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Pending Booths -->
            <Border Grid.Column="6" Style="{StaticResource StandardCardStyle}" Padding="16" Background="White">
                <StackPanel>
                    <TextBlock Text="قيد المراجعة" Style="{StaticResource SmallStyle}" Foreground="{StaticResource WarningTextBrush}"/>
                    <TextBlock Text="{Binding PendingCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content Split -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <!-- Booths Grid (2/3) -->
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="24"/>
                <!-- Form Panel (1/3) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Booths DataGrid -->
            <Border Grid.Column="0" Style="{StaticResource StandardCardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="قائمة الأجنحة" Style="{StaticResource H3Style}" Margin="0,0,0,16" Grid.Row="0"/>
                    
                    <DataGrid ItemsSource="{Binding Booths}"
                              Style="{StaticResource AppDataGridStyle}"
                              ColumnHeaderStyle="{StaticResource AppDataGridColumnHeaderStyle}"
                              RowStyle="{StaticResource AppDataGridRowStyle}"
                              CellStyle="{StaticResource AppDataGridCellStyle}"
                              AutoGenerateColumns="False"
                              Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم الجناح" Binding="{Binding BoothNumber}" Width="*"/>
                            <DataGridTextColumn Header="المساحة (م²)" Binding="{Binding OriginalAreaSqM}" Width="*"/>
                            <DataGridTextColumn Header="العرض (م)" Binding="{Binding Width}" Width="*"/>
                            <DataGridTextColumn Header="الارتفاع (م)" Binding="{Binding Height}" Width="*"/>
                            
                            <DataGridTemplateColumn Header="الفئة" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <badges:CategoryBadgeControl Category="{Binding ShapeType}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="الحالة" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <badges:StatusBadgeControl Status="{Binding Status}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="الإجراءات" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="حذف" 
                                                Style="{StaticResource DangerButtonStyle}"
                                                Command="{Binding DataContext.DeleteBoothCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding BoothID}"
                                                Padding="12,4" Height="28"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Add Booth Form Panel -->
            <Border Grid.Column="2" Style="{StaticResource StandardCardStyle}" Padding="20" Background="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="إضافة جناح جديد" Style="{StaticResource H3Style}" Margin="0,0,0,16"/>

                        <!-- Booth Number -->
                        <TextBlock Text="رقم الجناح" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                 Text="{Binding NewBoothNumber, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,0,16"/>

                        <!-- Original Area -->
                        <TextBlock Text="المساحة الإجمالية (م²)" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                 Text="{Binding NewOriginalAreaSqM, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Width -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="العرض (م)" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                         Text="{Binding NewWidth, UpdateSourceTrigger=PropertyChanged}" 
                                         Margin="0,0,0,16"/>
                            </StackPanel>

                            <!-- Height -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="الارتفاع (م)" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                         Text="{Binding NewHeight, UpdateSourceTrigger=PropertyChanged}" 
                                         Margin="0,0,0,16"/>
                            </StackPanel>
                        </Grid>

                        <!-- Category (ShapeType) -->
                        <TextBlock Text="فئة الجناح" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                        <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                                  ItemsSource="{Binding ShapeTypes}" 
                                  SelectedItem="{Binding NewShapeType}" 
                                  Margin="0,0,0,24"/>

                        <!-- Save Button -->
                        <Button Content="إضافة الجناح ✓" 
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SaveBoothCommand}"
                                Height="48"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
