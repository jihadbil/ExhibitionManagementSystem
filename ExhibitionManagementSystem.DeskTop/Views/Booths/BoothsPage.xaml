<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Views.Booths.BoothsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:badges="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Badges"
             xmlns:feedback="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Feedback"
             xmlns:cards="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Cards"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             FlowDirection="RightToLeft">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <!-- Header (Title + Designer Button) -->
            <RowDefinition Height="Auto"/>
            <!-- Filters -->
            <RowDefinition Height="Auto"/>
            <!-- Statistics Cards -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content (Grid + Form Split) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="إدارة الأجنحة" Style="{StaticResource H1Style}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryButtonStyle}" 
                        Click="AddBooth_Click"
                        Height="40" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconAdd}" Width="14" Height="14" Stretch="Uniform" Fill="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="جناح جديد" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButtonStyle}" 
                        Command="{Binding OpenDesignerCommand}"
                        Height="40" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconLocation}" Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="المصمم البصري" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButtonStyle}" 
                        Command="{Binding OpenNodifyDesignerCommand}"
                        Height="40">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconServices}" Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="مصمم الأجنحة المطور" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource StandardCardStyle}" Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <!-- Exhibition Select -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="اختر المعرض" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                    <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                              ItemsSource="{Binding Exhibitions}" 
                              SelectedValuePath="ExhibitionID" 
                              DisplayMemberPath="Name" 
                              SelectedValue="{Binding SelectedExhibitionId}"/>
                </StackPanel>

                <!-- Hall Select -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="اختر الصالة" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                    <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                              ItemsSource="{Binding AvailableHalls}" 
                              SelectedValuePath="HallID" 
                              DisplayMemberPath="HallName" 
                              SelectedValue="{Binding SelectedHallId}"/>
                </StackPanel>

                <!-- Status Filter -->
                <StackPanel Grid.Column="4">
                    <TextBlock Text="تصفية بالحالة" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                    <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                              ItemsSource="{Binding StatusFilters}" 
                              SelectedItem="{Binding StatusFilter}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Statistics Cards -->
        <Grid Grid.Row="2" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Booths -->
            <cards:StatCardControl Grid.Column="0"
                                   Title="إجمالي الأجنحة"
                                   Value="{Binding TotalCount}"
                                   IconGeometry="{StaticResource IconBooth}"/>

            <!-- Available Booths -->
            <cards:StatCardControl Grid.Column="2"
                                   Title="الأجنحة المتاحة"
                                   Value="{Binding AvailableCount}"
                                   IconGeometry="{StaticResource IconApprove}"
                                   IconBackground="{StaticResource SuccessLightBrush}"/>

            <!-- Reserved Booths -->
            <cards:StatCardControl Grid.Column="4"
                                   Title="الأجنحة المحجوزة"
                                   Value="{Binding ReservedCount}"
                                   IconGeometry="{StaticResource IconReservation}"
                                   IconBackground="{StaticResource InfoLightBrush}"/>

            <!-- Pending Booths -->
            <cards:StatCardControl Grid.Column="6"
                                   Title="قيد المراجعة"
                                   Value="{Binding PendingCount}"
                                   IconGeometry="{StaticResource IconWarning}"
                                   IconBackground="{StaticResource WarningLightBrush}"/>
        </Grid>

        <!-- Main Content Split -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <!-- Booths Grid (Full width) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Booths DataGrid -->
            <Border Grid.Column="0" Style="{StaticResource StandardCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="قائمة الأجنحة" Style="{StaticResource H3Style}" Margin="0,0,0,16" Grid.Row="0"/>
                    
                    <DataGrid ItemsSource="{Binding Booths}"
                              Style="{StaticResource AppDataGridStyle}"
                              ColumnHeaderStyle="{StaticResource AppDataGridColumnHeaderStyle}"
                              RowStyle="{StaticResource AppDataGridRowStyle}"
                              CellStyle="{StaticResource AppDataGridCellStyle}"
                              AutoGenerateColumns="False"
                              Visibility="{Binding Booths.Count, Converter={StaticResource InverseCountToVisibility}}"
                              Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم الجناح" Binding="{Binding BoothNumber}" Width="*"/>
                            <DataGridTextColumn Header="المساحة (م²)" Binding="{Binding OriginalAreaSqM}" Width="*"/>
                            <DataGridTextColumn Header="العرض (م)" Binding="{Binding Width}" Width="*"/>
                            <DataGridTextColumn Header="الطول (م)" Binding="{Binding Height}" Width="*"/>
                            
                            <DataGridTemplateColumn Header="الفئة" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <badges:CategoryBadgeControl Category="{Binding ShapeType}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="الحالة" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <badges:StatusBadgeControl Status="{Binding Status}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="الإجراءات" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="تعديل" 
                                                    Style="{StaticResource SmallSecondaryButtonStyle}"
                                                    Click="EditBooth_Click"
                                                    Tag="{Binding}"
                                                    Margin="0,0,6,0"/>
                                            <Button Content="حذف" 
                                                    Style="{StaticResource SmallDangerButtonStyle}"
                                                    Command="{Binding DataContext.DeleteBoothCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding BoothID}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <feedback:EmptyStateControl 
                        Visibility="{Binding Booths.Count, Converter={StaticResource CountToVisibility}}"
                        IconGeometry="{StaticResource IconBooth}"
                        Title="لا توجد أجنحة حالياً"
                        Description="لا توجد أجنحة مطابقة لخيارات التصفية الحالية أو لم يتم تعريف أجنحة بعد."
                        Grid.Row="1"/>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Loading Overlay -->
        <feedback:LoadingOverlayControl Grid.Row="0" Grid.RowSpan="4"
                                         IsLoading="{Binding IsBusy}"
                                         Message="جاري تحميل الأجنحة..."/>
    </Grid>
</UserControl>
