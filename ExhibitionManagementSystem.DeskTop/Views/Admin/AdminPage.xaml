<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Views.Admin.AdminPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:nav="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Navigation"
             xmlns:forms="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Forms"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             FlowDirection="RightToLeft">
    
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Tabs Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="إدارة النظام وسجل العمليات" Style="{StaticResource H1Style}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <!-- Main TabControl -->
        <TabControl Grid.Row="1" Style="{StaticResource AppTabControlStyle}">
            <!-- Tab 1: Audit Logs -->
            <TabItem Header="سجل العمليات (Audit Logs)" Style="{StaticResource AppTabItemStyle}">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <!-- Filter Bar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Logs DataGrid -->
                        <RowDefinition Height="*"/>
                        <!-- Pagination -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Bar -->
                    <Border Grid.Row="0" Style="{StaticResource StandardCardStyle}" Padding="16" Margin="0,0,0,20">
                        <forms:SearchBarControl SearchText="{Binding TableNameFilter}"
                                                PlaceholderText="تصفية حسب اسم الجدول (مثال: Exhibition, Reservation)..."
                                                SearchCommand="{Binding LoadAuditLogsCommand}"
                                                ButtonText="تصفية وتحديث"/>
                    </Border>

                    <!-- DataGrid -->
                    <Border Grid.Row="1" Style="{StaticResource StandardCardStyle}" Padding="20" Margin="0,0,0,16">
                        <DataGrid ItemsSource="{Binding AuditLogs}"
                                  Style="{StaticResource AppDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource AppDataGridColumnHeaderStyle}"
                                  RowStyle="{StaticResource AppDataGridRowStyle}"
                                  CellStyle="{StaticResource AppDataGridCellStyle}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الجدول" Binding="{Binding TableName}" Width="1.2*"/>
                                <DataGridTextColumn Header="العملية" Binding="{Binding Action}" Width="*"/>
                                <DataGridTextColumn Header="مُعرّف السجل" Binding="{Binding RecordID}" Width="1.2*"/>
                                <DataGridTextColumn Header="المستخدم" Binding="{Binding UserName}" Width="1.5*"/>
                                <DataGridTextColumn Header="تاريخ العملية" Binding="{Binding ActionAt, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="1.8*"/>
                                <DataGridTextColumn Header="القيم السابقة" Binding="{Binding OldValues}" Width="3*"/>
                                <DataGridTextColumn Header="القيم الجديدة" Binding="{Binding NewValues}" Width="3*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Pagination -->
                    <nav:PaginationControl Grid.Row="2"
                                           CurrentPage="{Binding AuditCurrentPage}"
                                           TotalPages="{Binding AuditTotalPages}"
                                           TotalCount="{Binding AuditTotalCount}"
                                           UnitLabel="سجل"
                                           PrevCommand="{Binding AuditPrevPageCommand}"
                                           NextCommand="{Binding AuditNextPageCommand}"/>
                </Grid>
            </TabItem>

            <!-- Tab 2: Subscription History & Management -->
            <TabItem Header="اشتراكات النظام (Subscriptions)" Style="{StaticResource AppTabItemStyle}">
                <Grid Margin="0,16,0,0">
                    <!-- Subscriptions Grid -->
                    <Border Style="{StaticResource StandardCardStyle}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="سجل الاشتراكات" Style="{StaticResource H2Style}" Margin="0,0,0,16"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Subscriptions}"
                                      Style="{StaticResource AppDataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource AppDataGridColumnHeaderStyle}"
                                      RowStyle="{StaticResource AppDataGridRowStyle}"
                                      CellStyle="{StaticResource AppDataGridCellStyle}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الشركة المستأجرة" Binding="{Binding TenantName}" Width="2*"/>
                                    <DataGridTextColumn Header="الباقة / الخطة" Binding="{Binding PlanName}" Width="1.5*"/>
                                    <DataGridTextColumn Header="قيمة الاشتراك" Binding="{Binding Price}" Width="1.2*"/>
                                    <DataGridTextColumn Header="العملة" Binding="{Binding CurrencyCode}" Width="*"/>
                                    <DataGridTextColumn Header="تاريخ البدء" Binding="{Binding StartDate, StringFormat={}{0:dd/MM/yyyy}}" Width="1.5*"/>
                                    <DataGridTextColumn Header="تاريخ الانتهاء" Binding="{Binding EndDate, StringFormat={}{0:dd/MM/yyyy}}" Width="1.5*"/>
                                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="1.2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
