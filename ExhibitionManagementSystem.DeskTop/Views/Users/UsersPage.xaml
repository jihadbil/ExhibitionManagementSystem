<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Views.Users.UsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:feedback="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Feedback"
             xmlns:nav="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Navigation"
             xmlns:forms="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Forms"
             xmlns:badges="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Badges"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <!-- A simple local converter to join List<string> to string -->
        <Style x:Key="RoleBadgesStyle" TargetType="ItemsControl">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border Background="{StaticResource BgSecondaryBrush}" 
                                CornerRadius="6" 
                                Padding="8,4" 
                                Margin="0,0,6,0">
                            <TextBlock Text="{Binding}" 
                                       Foreground="{StaticResource TextSecondaryBrush}" 
                                       FontSize="12" 
                                       FontWeight="Medium"/>
                        </Border>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <!-- Header (Title + New User button) -->
            <RowDefinition Height="Auto"/>
            <!-- Search Bar -->
            <RowDefinition Height="Auto"/>
            <!-- DataGrid Area -->
            <RowDefinition Height="*"/>
            <!-- Pagination Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="إدارة المستخدمين والأدوار" Style="{StaticResource H1Style}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <Button Style="{StaticResource PrimaryButtonStyle}" 
                    Click="AddUser_Click" 
                    Width="180" Height="48" 
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconAdd}" Width="14" Height="14" Stretch="Uniform" Fill="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="مستخدم جديد" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Search Bar -->
        <Border Grid.Row="1" Style="{StaticResource StandardCardStyle}" Padding="16" Margin="0,0,0,24">
            <forms:SearchBarControl SearchText="{Binding SearchQuery}"
                                    PlaceholderText="ابحث عن اسم المستخدم أو البريد الإلكتروني..."
                                    SearchCommand="{Binding SearchCommand}"/>
        </Border>

        <!-- DataGrid Area -->
        <Border Grid.Row="2" Style="{StaticResource StandardCardStyle}" Padding="20" Margin="0,0,0,20">
            <Grid>
                <DataGrid ItemsSource="{Binding Users}"
                          Style="{StaticResource AppDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource AppDataGridColumnHeaderStyle}"
                          RowStyle="{StaticResource AppDataGridRowStyle}"
                          CellStyle="{StaticResource AppDataGridCellStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Visibility="{Binding Users.Count, Converter={StaticResource InverseCountToVisibility}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="2*"/>
                        <DataGridTextColumn Header="البريد الإلكتروني" Binding="{Binding Email}" Width="2*"/>
                        
                        <DataGridTemplateColumn Header="الأدوار" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding Roles}" Style="{StaticResource RoleBadgesStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="الحالة" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <badges:StatusBadgeControl Status="{Binding IsActive}" HorizontalAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="الإجراءات" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Toggle status button -->
                                        <Button Content="تفعيل / تعطيل" 
                                                Style="{StaticResource SmallSecondaryButtonStyle}"
                                                Click="ToggleStatus_Click"
                                                Tag="{Binding}"
                                                Margin="0,0,8,0"/>
                                        
                                        <!-- Delete button -->
                                        <Button Style="{StaticResource SmallDangerButtonStyle}"
                                                Click="Delete_Click"
                                                Tag="{Binding UserId}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconDelete}" Width="11" Height="11" Stretch="Uniform" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="حذف" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <feedback:EmptyStateControl 
                    Visibility="{Binding Users.Count, Converter={StaticResource CountToVisibility}}"
                    IconGeometry="{StaticResource IconUsers}"
                    Title="لا يوجد مستخدمون حالياً"
                    Description="لم يتم العثور على أي مستخدمين مسجلين في النظام، أو لا توجد نتائج مطابقة لبحثك."/>
            </Grid>
        </Border>

        <!-- Pagination Footer -->
        <nav:PaginationControl Grid.Row="3"
                               CurrentPage="{Binding CurrentPage}"
                               TotalPages="{Binding TotalPages}"
                               TotalCount="{Binding TotalCount}"
                               UnitLabel="مستخدم"
                               PrevCommand="{Binding PrevPageCommand}"
                               NextCommand="{Binding NextPageCommand}"/>
        
        <!-- Loading Overlay -->
        <feedback:LoadingOverlayControl Grid.Row="0" Grid.RowSpan="4"
                                         IsLoading="{Binding IsBusy}"
                                         Message="جاري تحميل المستخدمين..."/>
    </Grid>
</UserControl>
