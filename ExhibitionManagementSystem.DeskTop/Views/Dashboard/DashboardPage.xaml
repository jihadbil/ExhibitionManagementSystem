<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Views.Dashboard.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cards="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Cards"
             xmlns:charts="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Charts"
             xmlns:badges="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Badges"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">

            <!-- Header: تحية + وقت -->
            <Grid Margin="0,0,0,24">
                <TextBlock Text="{Binding Greeting}" Style="{StaticResource H1Style}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentTime}" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding CurrentDate}" Style="{StaticResource SmallStyle}"/>
                </StackPanel>
            </Grid>

            <!-- 4 StatCards -->
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,24">
                <cards:StatCardControl Title="المعارض النشطة"
                    Value="{Binding ActiveExhibitions}"
                    TrendText="+2 هذا الشهر" TrendIsPositive="True"
                    IconText="🏛️" Margin="0,0,12,0"
                    IconBackground="{StaticResource InfoLightBrush}"/>
                <cards:StatCardControl Title="الأجنحة المحجوزة"
                    Value="{Binding OccupiedBooths}"
                    TrendText="معدل ممتاز" TrendIsPositive="True"
                    IconText="🏪" Margin="6,0"
                    IconBackground="{StaticResource SuccessLightBrush}"/>
                <cards:StatCardControl Title="الشركات العارضة"
                    Value="{Binding TotalExhibitors}"
                    TrendText="شركاء النجاح" TrendIsPositive="True"
                    IconText="🏢" Margin="6,0"
                    IconBackground="{StaticResource WarningLightBrush}"/>
                <cards:StatCardControl Title="الزوار المسجلين"
                    Value="{Binding TotalVisitors}"
                    TrendText="نمو متزايد" TrendIsPositive="True"
                    IconText="👥" Margin="12,0,0,0"
                    IconBackground="{StaticResource DangerLightBrush}"/>
            </UniformGrid>

            <!-- Charts Row -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Bar Chart -->
                <Border Grid.Column="0" Style="{StaticResource StandardCardStyle}">
                    <StackPanel>
                        <TextBlock Text="إحصائيات الإيرادات الشهرية" Style="{StaticResource H3Style}"
                                   Margin="0,0,0,16"/>
                        <charts:BarChartControl Height="220"
                            SeriesData="{Binding MonthlyStats}"/>
                    </StackPanel>
                </Border>

                <!-- Donut Chart -->
                <Border Grid.Column="2" Style="{StaticResource StandardCardStyle}">
                    <StackPanel>
                        <TextBlock Text="توزيع المعارض حسب الفئة" Style="{StaticResource H3Style}"
                                   Margin="0,0,0,16"/>
                        <charts:DonutChartControl Height="220"
                            Segments="{Binding TypeDistribution}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Upcoming Exhibitions Table -->
            <Border Style="{StaticResource StandardCardStyle}">
                <StackPanel>
                    <TextBlock Text="جدول المعارض القادمة" Style="{StaticResource H3Style}"
                               Margin="0,0,0,16"/>
                    <DataGrid ItemsSource="{Binding UpcomingExhibitions}"
                               Style="{StaticResource AppDataGridStyle}"
                               ColumnHeaderStyle="{StaticResource AppDataGridColumnHeaderStyle}"
                               RowStyle="{StaticResource AppDataGridRowStyle}"
                               CellStyle="{StaticResource AppDataGridCellStyle}"
                               AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="اسم المعرض" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="الموقع" Binding="{Binding VenueName}" Width="*"/>
                            <DataGridTextColumn Header="تاريخ البداية"
                                 Binding="{Binding StartDate, StringFormat='{}{0:d MMM yyyy}'}" Width="*"/>
                            <DataGridTemplateColumn Header="الحالة" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <badges:StatusBadgeControl Status="{Binding Status}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
