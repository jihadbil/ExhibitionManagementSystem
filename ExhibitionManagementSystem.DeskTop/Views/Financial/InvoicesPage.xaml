<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Views.Financial.InvoicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:badges="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Badges"
             xmlns:feedback="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Feedback"
             xmlns:nav="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Navigation"
             xmlns:cards="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Cards"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             FlowDirection="RightToLeft">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <!-- Header (Title) -->
            <RowDefinition Height="Auto"/>
            <!-- Filters Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Statistics Cards -->
            <RowDefinition Height="Auto"/>
            <!-- DataGrid Area -->
            <RowDefinition Height="*"/>
            <!-- Pagination Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="إدارة الفواتير والمدفوعات" Style="{StaticResource H1Style}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <!-- Filters Bar -->
        <Border Grid.Row="1" Style="{StaticResource StandardCardStyle}" Padding="16" Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status filter -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="تصفية حسب الحالة" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                    <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                              ItemsSource="{Binding StatusFilters}" 
                              SelectedItem="{Binding StatusFilter}"
                              Width="250"
                              HorizontalAlignment="Right"/>
                </StackPanel>

                <!-- View Overdue Button -->
                <Button Grid.Column="2" 
                        Style="{StaticResource DangerButtonStyle}" 
                        Command="{Binding LoadOverdueCommand}" 
                        Width="180" Height="48"
                        VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconWarning}" Width="14" Height="14" Stretch="Uniform" Fill="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="عرض المتأخرات فقط" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Statistics Cards -->
        <Grid Grid.Row="2" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Count -->
            <cards:StatCardControl Grid.Column="0"
                                   Title="إجمالي الفواتير"
                                   Value="{Binding TotalCount}"
                                   IconGeometry="{StaticResource IconInvoice}"/>

            <!-- Card 2: Paid Count -->
            <cards:StatCardControl Grid.Column="2"
                                   Title="مدفوعة بالكامل"
                                   Value="{Binding PaidCount}"
                                   IconGeometry="{StaticResource IconApprove}"
                                   IconBackground="{StaticResource SuccessLightBrush}"/>

            <!-- Card 3: Pending Count -->
            <cards:StatCardControl Grid.Column="4"
                                   Title="غير مدفوعة (معلقة)"
                                   Value="{Binding PendingCount}"
                                   IconGeometry="{StaticResource IconWarning}"
                                   IconBackground="{StaticResource WarningLightBrush}"/>

            <!-- Card 4: Overdue Count -->
            <cards:StatCardControl Grid.Column="6"
                                   Title="متجاوزة لتاريخ الاستحقاق"
                                   Value="{Binding OverdueCount}"
                                   IconGeometry="{StaticResource IconCancel}"
                                   IconBackground="{StaticResource DangerLightBrush}"/>
        </Grid>

        <!-- DataGrid Area -->
        <Border Grid.Row="3" Style="{StaticResource StandardCardStyle}" Padding="20" Margin="0,0,0,20">
            <Grid>
                <DataGrid ItemsSource="{Binding Invoices}"
                          Style="{StaticResource AppDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource AppDataGridColumnHeaderStyle}"
                          RowStyle="{StaticResource AppDataGridRowStyle}"
                          CellStyle="{StaticResource AppDataGridCellStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Visibility="{Binding Invoices.Count, Converter={StaticResource InverseCountToVisibility}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="*"/>
                        <DataGridTextColumn Header="الشركة العارضة" Binding="{Binding ExhibitorName}" Width="2*"/>
                        <DataGridTextColumn Header="تاريخ الفاتورة" Binding="{Binding InvoiceDate, StringFormat=d}" Width="*"/>
                        <DataGridTextColumn Header="تاريخ الاستحقاق" Binding="{Binding DueDate, StringFormat=d, TargetNullValue='-'}" Width="*"/>
                        
                        <DataGridTextColumn Header="إجمالي المبلغ" Binding="{Binding TotalAmount, StringFormat=N2}" Width="*"/>
                        
                        <DataGridTemplateColumn Header="الحالة" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <badges:StatusBadgeControl Status="{Binding Status}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="الإجراءات" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource SmallSecondaryButtonStyle}"
                                                Click="ViewDetails_Click"
                                                Tag="{Binding InvoiceID}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconInvoice}" Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="عرض التفاصيل" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <feedback:EmptyStateControl 
                    Visibility="{Binding Invoices.Count, Converter={StaticResource CountToVisibility}}"
                    IconGeometry="{StaticResource IconInvoice}"
                    Title="لا توجد فواتير حالياً"
                    Description="لم يتم إصدار أي فواتير بعد في النظام، أو لا توجد فواتير تطابق خيارات التصفية الحالية."/>
            </Grid>
        </Border>

        <!-- Pagination Footer -->
        <nav:PaginationControl Grid.Row="4"
                               CurrentPage="{Binding CurrentPage}"
                               TotalPages="{Binding TotalPages}"
                               TotalCount="{Binding TotalCount}"
                               UnitLabel="فاتورة"
                               PrevCommand="{Binding PrevPageCommand}"
                               NextCommand="{Binding NextPageCommand}"/>
        
        <!-- Loading Overlay -->
        <feedback:LoadingOverlayControl Grid.Row="0" Grid.RowSpan="5"
                                         IsLoading="{Binding IsBusy}"
                                         Message="جاري تحميل الفواتير..."/>
    </Grid>
</UserControl>
