<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Views.Analytics.AnalyticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:cards="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Cards"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             FlowDirection="RightToLeft">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <!-- Title + Export Button -->
            <RowDefinition Height="Auto"/>
            <!-- Filters -->
            <RowDefinition Height="Auto"/>
            <!-- 4 Glass StatCards -->
            <RowDefinition Height="Auto"/>
            <!-- Charts Row -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="تحليلات المعارض والمبيعات" Style="{StaticResource H1Style}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <Button Style="{StaticResource PrimaryButtonStyle}" 
                    Command="{Binding ExportReportCommand}"
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Left"
                    Width="180" Height="40">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconExport}" Width="14" Height="14" Stretch="Uniform" Fill="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="تصدير تقرير PDF" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource StandardCardStyle}" Padding="16" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="اختر المعرض لاستعراض التحليلات" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                          ItemsSource="{Binding Exhibitions}" 
                          SelectedValuePath="ExhibitionID" 
                          DisplayMemberPath="Name" 
                          SelectedValue="{Binding SelectedExhibitionId}"/>
            </StackPanel>
        </Border>

        <!-- 4 Stat Cards -->
        <UniformGrid Grid.Row="2" Rows="1" Columns="4" Margin="0,0,0,24">
            <!-- Visitors -->
            <cards:StatCardControl Margin="0,0,12,0"
                                   Title="إجمالي الزوار"
                                   Value="{Binding TotalVisitors}"
                                   IconGeometry="{StaticResource IconUsers}"/>

            <!-- Exhibitors -->
            <cards:StatCardControl Margin="6,0"
                                   Title="الشركات العارضة"
                                   Value="{Binding TotalExhibitors}"
                                   IconGeometry="{StaticResource IconCompany}"
                                   IconBackground="{StaticResource SecondaryLightBrush}"/>

            <!-- Occupancy Rate -->
            <cards:StatCardControl Margin="6,0"
                                   Title="معدل إشغال الصالة"
                                   Value="{Binding OccupancyRate, StringFormat='{}{0:F1} %'}"
                                   IconGeometry="{StaticResource IconBooth}"
                                   IconBackground="{StaticResource SuccessLightBrush}"/>

            <!-- Revenue -->
            <cards:StatCardControl Margin="12,0,0,0"
                                   Title="صافي الأرباح"
                                   IconGeometry="{StaticResource IconInvoice}"
                                   IconBackground="{StaticResource DangerLightBrush}">
                <cards:StatCardControl.Value>
                    <MultiBinding StringFormat="{}{0:N1} {1}">
                        <Binding Path="NetProfit"/>
                        <Binding Path="CurrencyCode"/>
                    </MultiBinding>
                </cards:StatCardControl.Value>
            </cards:StatCardControl>
        </UniformGrid>

        <!-- Main Splits -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <!-- Chart Area (2/3) -->
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="24"/>
                <!-- Financials Card (1/3) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Traffic Chart Card -->
            <Border Grid.Column="0" Style="{StaticResource StandardCardStyle}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="مخطط تدفق حركة الزوار على مدار اليوم (توزيع افتراضي)" Style="{StaticResource H3Style}" Margin="0,0,0,16" Grid.Row="0"/>
                    
                    <lvc:CartesianChart Grid.Row="1"
                                        Series="{Binding ChartSeries}"
                                        XAxes="{Binding XAxes}"
                                        YAxes="{Binding YAxes}"
                                        TooltipPosition="Top"
                                        LegendPosition="Hidden"/>
                </Grid>
            </Border>

            <!-- Detailed Financials Card -->
            <Border Grid.Column="2" Style="{StaticResource StandardCardStyle}" Padding="20" Background="White">
                <StackPanel>
                    <TextBlock Text="الملخص المالي التفصيلي" Style="{StaticResource H3Style}" Margin="0,0,0,24"/>

                    <!-- Total Revenue -->
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="إجمالي الإيرادات:" Style="{StaticResource LabelStyle}" HorizontalAlignment="Right"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding TotalRevenue, StringFormat='{}{0:N1}'}" Style="{StaticResource BodyStyle}" FontWeight="Bold"/>
                            <TextBlock Text=" " Style="{StaticResource BodyStyle}"/>
                            <TextBlock Text="{Binding CurrencyCode}" Style="{StaticResource BodySecondaryStyle}"/>
                        </StackPanel>
                    </Grid>
                    <Border BorderBrush="{StaticResource BorderMainBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,16"/>

                    <!-- Total Expenses -->
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="إجمالي المصاريف:" Style="{StaticResource LabelStyle}" HorizontalAlignment="Right"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding TotalExpenses, StringFormat='{}{0:N1}'}" Style="{StaticResource BodyStyle}" FontWeight="Bold"/>
                            <TextBlock Text=" " Style="{StaticResource BodyStyle}"/>
                            <TextBlock Text="{Binding CurrencyCode}" Style="{StaticResource BodySecondaryStyle}"/>
                        </StackPanel>
                    </Grid>
                    <Border BorderBrush="{StaticResource BorderMainBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,16"/>

                    <!-- Net Profit -->
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="صافي الأرباح:" Style="{StaticResource LabelStyle}" HorizontalAlignment="Right"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding NetProfit, StringFormat='{}{0:N1}'}" Style="{StaticResource BodyStyle}" FontWeight="Bold" Foreground="{StaticResource SuccessTextBrush}"/>
                            <TextBlock Text=" " Style="{StaticResource BodyStyle}"/>
                            <TextBlock Text="{Binding CurrencyCode}" Style="{StaticResource BodySecondaryStyle}" Foreground="{StaticResource SuccessTextBrush}"/>
                        </StackPanel>
                    </Grid>
                    <Border BorderBrush="{StaticResource BorderMainBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,16"/>

                    <!-- Stats summary list -->
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="إجمالي الأجنحة المدرجة:" Style="{StaticResource LabelStyle}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding TotalBooths}" Style="{StaticResource BodyStyle}" FontWeight="Bold" HorizontalAlignment="Left"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
