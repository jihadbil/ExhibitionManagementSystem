<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Views.Settings.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             FlowDirection="RightToLeft">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- Content tabs -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="إعدادات الحساب والنظام" Style="{StaticResource H1Style}" Margin="0,0,0,24"/>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- TAB 1: User Profile -->
            <TabItem Header="👤 معلومات الملف الشخصي" Height="36" Padding="16,0" FontFamily="{StaticResource WorkSansMedium}" FontSize="14" FontWeight="Medium">
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="500"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StandardCardStyle}" Padding="24" Background="White" Height="Auto" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="تعديل البيانات الشخصية" Style="{StaticResource H3Style}" Margin="0,0,0,20"/>

                            <!-- Full Name -->
                            <TextBlock Text="الاسم الكامل" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                     Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" 
                                     Margin="0,0,0,16"/>

                            <!-- Email -->
                            <TextBlock Text="البريد الإلكتروني (غير قابل للتعديل)" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                     Text="{Binding Email}" 
                                     IsEnabled="False"
                                     Margin="0,0,0,16"/>

                            <!-- Phone Number -->
                            <TextBlock Text="رقم الهاتف" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                     Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" 
                                     Margin="0,0,0,16"/>

                            <!-- Tenant Name -->
                            <TextBlock Text="اسم المنظمة / المعرض التابع له" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                     Text="{Binding TenantName}" 
                                     IsEnabled="False"
                                     Margin="0,0,0,16"/>

                            <!-- System Role -->
                            <TextBlock Text="دور المستخدم / الصلاحية" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                     Text="{Binding UserRole}" 
                                     IsEnabled="False"
                                     Margin="0,0,0,24"/>

                            <!-- Save Button -->
                            <Button Content="حفظ التغييرات ✓" 
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SaveProfileCommand}"
                                    Height="48"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: Account Security -->
            <TabItem Header="🔒 أمان الحساب وكلمة المرور" Height="36" Padding="16,0" FontFamily="{StaticResource WorkSansMedium}" FontSize="14" FontWeight="Medium">
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="500"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StandardCardStyle}" Padding="24" Background="White" Height="Auto" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="تغيير كلمة المرور" Style="{StaticResource H3Style}" Margin="0,0,0,20"/>

                            <!-- Current Password -->
                            <TextBlock Text="كلمة المرور الحالية" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="CurrentPasswordBox" Style="{StaticResource StandardPasswordBoxStyle}" Margin="0,0,0,16"/>

                            <!-- New Password -->
                            <TextBlock Text="كلمة المرور الجديدة (6 رموز على الأقل)" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource StandardPasswordBoxStyle}" Margin="0,0,0,16"/>

                            <!-- Confirm Password -->
                            <TextBlock Text="تأكيد كلمة المرور الجديدة" Style="{StaticResource LabelStyle}" Margin="0,0,0,24"/>
                            <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource StandardPasswordBoxStyle}" Margin="0,0,0,24"/>

                            <!-- Save Password Button -->
                            <Button Content="تحديث كلمة المرور 🔒" 
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="ChangePassword_Click"
                                    Height="48"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
