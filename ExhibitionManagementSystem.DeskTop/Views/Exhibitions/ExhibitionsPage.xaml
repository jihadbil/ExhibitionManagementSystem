<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Views.Exhibitions.ExhibitionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cards="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Cards"
             xmlns:feedback="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Feedback"
             xmlns:nav="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Navigation"
             xmlns:forms="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Forms"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             FlowDirection="RightToLeft">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <!-- Header (Title + Add Button) -->
            <RowDefinition Height="Auto"/>
            <!-- Search / Filter Area -->
            <RowDefinition Height="Auto"/>
            <!-- Cards Grid -->
            <RowDefinition Height="*"/>
            <!-- Pagination Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="إدارة المعارض" Style="{StaticResource H1Style}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <Button Content="+ معرض جديد" 
                    Style="{StaticResource PrimaryButtonStyle}" 
                    Click="AddExhibition_Click"
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Left"
                    Width="160" Height="40"/>
        </Grid>

        <!-- Search Area -->
        <Border Grid.Row="1" Style="{StaticResource StandardCardStyle}" Padding="16" Margin="0,0,0,24">
            <forms:SearchBarControl SearchText="{Binding SearchQuery}"
                                    PlaceholderText="ابحث عن معرض بالاسم..."
                                    SearchCommand="{Binding LoadExhibitionsCommand}"/>
        </Border>

        <!-- Cards Grid & Empty State -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding Exhibitions.Count, Converter={StaticResource InverseCountToVisibility}}">
                <ItemsControl ItemsSource="{Binding Exhibitions}" Grid.Row="1" Margin="-8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <cards:ExhibitionCardControl 
                                ExhibitionId="{Binding ExhibitionID}"
                                ExhibitionName="{Binding Name}"
                                Type="{Binding Type}"
                                StartDate="{Binding StartDate}"
                                EndDate="{Binding EndDate}"
                                VenueName="{Binding VenueName}"
                                Status="{Binding Status}"
                                EditRequested="Card_EditRequested"
                                DeleteRequested="Card_DeleteRequested"
                                StatusChanged="Card_StatusChanged"
                                Margin="8"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <feedback:EmptyStateControl 
                Visibility="{Binding Exhibitions.Count, Converter={StaticResource CountToVisibility}}"
                IconGeometry="{StaticResource IconExhibition}"
                Title="لا توجد معارض حالياً"
                Description="لم يتم تسجيل أي معرض بعد في النظام. اضغط على زر 'معرض جديد' للبدء في إضافة معرض."/>
        </Grid>

        <!-- Pagination Footer -->
        <nav:PaginationControl Grid.Row="3"
                               CurrentPage="{Binding CurrentPage}"
                               TotalPages="{Binding TotalPages}"
                               TotalCount="{Binding TotalCount}"
                               UnitLabel="معارض"
                               PrevCommand="{Binding PrevPageCommand}"
                               NextCommand="{Binding NextPageCommand}"/>
        <!-- Loading Overlay -->
        <feedback:LoadingOverlayControl Grid.Row="0" Grid.RowSpan="4"
                                         IsLoading="{Binding IsBusy}"
                                         Message="جاري تحميل المعارض..."/>
    </Grid>
</UserControl>
