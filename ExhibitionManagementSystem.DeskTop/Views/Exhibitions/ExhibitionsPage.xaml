<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Views.Exhibitions.ExhibitionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cards="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Cards"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             FlowDirection="RightToLeft">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <!-- Header (Title + Add Button) -->
            <RowDefinition Height="Auto"/>
            <!-- Search / Filter Area -->
            <RowDefinition Height="Auto"/>
            <!-- Cards Grid -->
            <RowDefinition Height="*"/>
            <!-- Pagination Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="إدارة المعارض" Style="{StaticResource H1Style}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <Button Content="+ معرض جديد" 
                    Style="{StaticResource PrimaryButtonStyle}" 
                    Click="AddExhibition_Click"
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Left"
                    Width="160" Height="40"/>
        </Grid>

        <!-- Search Area -->
        <Border Grid.Row="1" Style="{StaticResource StandardCardStyle}" Padding="16" Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         Grid.Column="0"
                         VerticalContentAlignment="Center"
                         Tag="ابحث عن معرض بالاسم..."/>

                <Button Style="{StaticResource PrimaryButtonStyle}" 
                        Command="{Binding LoadExhibitionsCommand}"
                        Content="🔍 بحث" 
                        Grid.Column="2"
                        Width="120" Height="48"/>
            </Grid>
        </Border>

        <!-- Cards Grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,20">
            <ItemsControl ItemsSource="{Binding Exhibitions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" VerticalAlignment="Top"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <cards:ExhibitionCardControl 
                            ExhibitionId="{Binding ExhibitionID}"
                            ExhibitionName="{Binding Name}"
                            Type="{Binding Type}"
                            StartDate="{Binding StartDate}"
                            EndDate="{Binding EndDate}"
                            VenueName="{Binding VenueName}"
                            Status="{Binding Status}"
                            EditRequested="Card_EditRequested"
                            DeleteRequested="Card_DeleteRequested"
                            Margin="8"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Pagination Footer -->
        <Grid Grid.Row="3" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Backwards -->
            <Button Style="{StaticResource SecondaryButtonStyle}" 
                    Command="{Binding PrevPageCommand}"
                    Content="الصفحة السابقة" 
                    Grid.Column="0"
                    HorizontalAlignment="Right"
                    Width="140"/>

            <!-- Status Indicator -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0">
                <TextBlock Text="الصفحة " Style="{StaticResource BodySecondaryStyle}"/>
                <TextBlock Text="{Binding CurrentPage}" Style="{StaticResource BodyStyle}" FontWeight="Bold"/>
                <TextBlock Text=" من " Style="{StaticResource BodySecondaryStyle}"/>
                <TextBlock Text="{Binding TotalPages}" Style="{StaticResource BodyStyle}" FontWeight="Bold"/>
                <TextBlock Text=" (الإجمالي: " Style="{StaticResource BodySecondaryStyle}"/>
                <TextBlock Text="{Binding TotalCount}" Style="{StaticResource BodyStyle}" FontWeight="Bold"/>
                <TextBlock Text=" معارض)" Style="{StaticResource BodySecondaryStyle}"/>
            </StackPanel>

            <!-- Forwards -->
            <Button Style="{StaticResource SecondaryButtonStyle}" 
                    Command="{Binding NextPageCommand}"
                    Content="الصفحة التالية" 
                    Grid.Column="2"
                    HorizontalAlignment="Left"
                    Width="140"/>
        </Grid>
    </Grid>
</UserControl>
