<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Views.Events.EventsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:feedback="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Feedback"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             FlowDirection="RightToLeft">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- Exhibition Selector Filter -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Split -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="جدول الفعاليات والمؤتمرات" Style="{StaticResource H1Style}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <Button Content="+ إضافة فعالية" 
                    Style="{StaticResource PrimaryButtonStyle}" 
                    Click="AddEvent_Click"
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Left"
                    Width="140" Height="40"/>
        </Grid>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource StandardCardStyle}" Padding="16" Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="تصفية حسب المعرض" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                    <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                              ItemsSource="{Binding Exhibitions}" 
                              SelectedValuePath="ExhibitionID" 
                              DisplayMemberPath="Name" 
                              SelectedValue="{Binding SelectedExhibitionId}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Split Grid -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Events List (Full width) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Events DataGrid Card -->
            <Border Grid.Column="0" Style="{StaticResource StandardCardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="الأنشطة والندوات المدرجة" Style="{StaticResource H3Style}" Margin="0,0,0,16" Grid.Row="0"/>

                    <DataGrid ItemsSource="{Binding Events}"
                              Style="{StaticResource AppDataGridStyle}"
                              ColumnHeaderStyle="{StaticResource AppDataGridColumnHeaderStyle}"
                              RowStyle="{StaticResource AppDataGridRowStyle}"
                              CellStyle="{StaticResource AppDataGridCellStyle}"
                              AutoGenerateColumns="False"
                              Visibility="{Binding Events.Count, Converter={StaticResource InverseCountToVisibility}}"
                              Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="النشاط / الفعالية" Binding="{Binding EventName}" Width="1.5*"/>
                            <DataGridTextColumn Header="المتحدث الرئيسي" Binding="{Binding SpeakerName}" Width="*"/>
                            <DataGridTextColumn Header="النوع" Binding="{Binding EventType}" Width="*"/>
                            <DataGridTextColumn Header="تاريخ ووقت البدء" Binding="{Binding StartDateTime, StringFormat='{}{0:dd MMM yyyy, HH:mm}'}" Width="1.5*"/>
                            <DataGridTextColumn Header="الحضور الأقصى" Binding="{Binding MaxAttendees}" Width="*"/>
                            
                            <DataGridTemplateColumn Header="عام" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="نعم" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" Visibility="{Binding IsPublic, Converter={StaticResource BoolToVisibility}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="الإجراءات" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource DangerButtonStyle}"
                                                Command="{Binding DataContext.DeleteScheduleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding ScheduleID}"
                                                Padding="10,2" Height="28">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconDelete}" Width="11" Height="11" Stretch="Uniform" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="حذف" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <feedback:EmptyStateControl 
                         Visibility="{Binding Events.Count, Converter={StaticResource CountToVisibility}}"
                         IconGeometry="{StaticResource IconCalendar}"
                         Title="لا توجد فعاليات حالياً"
                         Description="لم يتم تسجيل أي ندوة أو نشاط بعد لهذا المعرض."
                         Grid.Row="1"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Loading Overlay -->
        <feedback:LoadingOverlayControl Grid.Row="0" Grid.RowSpan="3"
                                          IsLoading="{Binding IsBusy}"
                                          Message="جاري تحميل الفعاليات..."/>
    </Grid>
</UserControl>
