<Window x:Class="ExhibitionManagementSystem.DeskTop.Views.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="ExpoManager — تسجيل الدخول" 
        Width="1200" Height="780" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left side: Form -->
            <ColumnDefinition Width="*"/>
            <!-- Right side: Brand Panel -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left side: Form -->
        <Border Grid.Column="0" Background="White" Padding="64,48">
            <StackPanel VerticalAlignment="Center" MaxWidth="460">

                <!-- Logo/Title -->
                <TextBlock Text="ExpoManager" Style="{StaticResource H1Style}" FontSize="34" Margin="0,0,0,10"/>
                <TextBlock Text="مرحباً بك، سجّل دخولك للمتابعة وإدارة فعالياتك"
                           Style="{StaticResource BodySecondaryStyle}"
                           FontSize="15"
                           Margin="0,0,0,36"/>

                <!-- Email Input -->
                <TextBlock Text="البريد الإلكتروني" Style="{StaticResource LabelStyle}" FontSize="14" Margin="0,0,0,8"/>
             
                <TextBox Style="{StaticResource StandardTextBoxStyle}"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Height="48" FontSize="14"
                         Margin="0,0,0,20"/>

                <!-- Password Input -->
                <TextBlock Text="كلمة المرور" Style="{StaticResource LabelStyle}" FontSize="14" Margin="0,0,0,8"/>
                <PasswordBox x:Name="PasswordField"
                             Style="{StaticResource StandardPasswordBoxStyle}"
                             PasswordChanged="PasswordField_PasswordChanged"
                             Height="48" FontSize="14"
                             Margin="0,0,0,12"/>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                           Margin="0,0,0,18"/>

                <!-- Loading indicator -->
                <ProgressBar IsIndeterminate="True" Height="4"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                             Foreground="{StaticResource PrimaryBrush}"
                             Margin="0,0,0,18"/>

                <!-- Login Button -->
                <Button Content="تسجيل الدخول"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding LoginCommand}"
                        HorizontalAlignment="Stretch"
                        Height="50" FontSize="15"
                        Margin="0,0,0,20"/>

                <!-- Forgot Password -->
                <Button Content="نسيت كلمة المرور؟"
                        Style="{StaticResource LinkButtonStyle}"
                        Command="{Binding ForgotPasswordCommand}"
                        HorizontalAlignment="Center"
                        FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- Right side: Brand Panel -->
        <Border Grid.Column="1" Background="{StaticResource PrimaryGradientBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path Data="{StaticResource IconExhibition}"
                      Width="92" Height="92"
                      Stretch="Uniform"
                      Fill="White"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,28"/>
                <TextBlock Text="ExpoManager"
                           Foreground="White" FontSize="44" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="نظام إدارة المعارض والفعاليات المتكامل"
                           Foreground="White" FontSize="18" Opacity="0.9"
                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
