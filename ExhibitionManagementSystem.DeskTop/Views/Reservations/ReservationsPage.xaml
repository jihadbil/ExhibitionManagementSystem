<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Views.Reservations.ReservationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:badges="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Badges"
             xmlns:feedback="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Feedback"
             xmlns:nav="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Navigation"
             xmlns:cards="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Cards"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             FlowDirection="RightToLeft">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <!-- Header (Title + Add Button) -->
            <RowDefinition Height="Auto"/>
            <!-- Filters Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Statistics Cards -->
            <RowDefinition Height="Auto"/>
            <!-- DataGrid Area -->
            <RowDefinition Height="*"/>
            <!-- Pagination Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="إدارة الحجوزات" Style="{StaticResource H1Style}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <Button Content="+ حجز جديد" 
                    Style="{StaticResource PrimaryButtonStyle}" 
                    Click="AddReservation_Click"
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Left"
                    Width="160" Height="40"/>
        </Grid>

        <!-- Filters Bar -->
        <Border Grid.Row="1" Style="{StaticResource StandardCardStyle}" Padding="16" Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Exhibition selection filter -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="تصفية حسب المعرض" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                    <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                              ItemsSource="{Binding Exhibitions}" 
                              SelectedValuePath="ExhibitionID" 
                              DisplayMemberPath="Name" 
                              SelectedValue="{Binding SelectedExhibitionId}"/>
                </StackPanel>

                <!-- Status filter -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="حالة الحجز" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                    <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                              ItemsSource="{Binding StatusFilters}" 
                              SelectedItem="{Binding StatusFilter}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Statistics Cards -->
        <Grid Grid.Row="2" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Count -->
            <cards:StatCardControl Grid.Column="0"
                                   Title="إجمالي الحجوزات"
                                   Value="{Binding TotalCount}"
                                   IconGeometry="{StaticResource IconReservation}"/>

            <!-- Card 2: Pending Count -->
            <cards:StatCardControl Grid.Column="2"
                                   Title="قيد المراجعة"
                                   Value="{Binding PendingCount}"
                                   IconGeometry="{StaticResource IconWarning}"
                                   IconBackground="{StaticResource WarningLightBrush}"/>

            <!-- Card 3: Approved Count -->
            <cards:StatCardControl Grid.Column="4"
                                   Title="موافق عليها"
                                   Value="{Binding ApprovedCount}"
                                   IconGeometry="{StaticResource IconApprove}"
                                   IconBackground="{StaticResource SuccessLightBrush}"/>

            <!-- Card 4: Unpaid Count -->
            <cards:StatCardControl Grid.Column="6"
                                   Title="غير مدفوعة"
                                   Value="{Binding UnpaidCount}"
                                   IconGeometry="{StaticResource IconCancel}"
                                   IconBackground="{StaticResource DangerLightBrush}"/>
        </Grid>

        <!-- DataGrid Area -->
        <Border Grid.Row="3" Style="{StaticResource StandardCardStyle}" Padding="20" Margin="0,0,0,20">
            <Grid>
                <DataGrid ItemsSource="{Binding Reservations}"
                          Style="{StaticResource AppDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource AppDataGridColumnHeaderStyle}"
                          RowStyle="{StaticResource AppDataGridRowStyle}"
                          CellStyle="{StaticResource AppDataGridCellStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Visibility="{Binding Reservations.Count, Converter={StaticResource InverseCountToVisibility}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الحجز" Binding="{Binding ReservationID}" Width="Auto"/>
                    <DataGridTextColumn Header="اسم الشركة" Binding="{Binding ExhibitorName}" Width="2*"/>
                    <DataGridTextColumn Header="رقم الجناح" Binding="{Binding BoothNumber}" Width="*"/>
                    <DataGridTextColumn Header="المعرض" Binding="{Binding ExhibitionName}" Width="2*"/>
                    <DataGridTextColumn Header="تاريخ الحجز" Binding="{Binding ReservationDate, StringFormat=d}" Width="*"/>
                    
                    <DataGridTemplateColumn Header="الحالة" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <badges:StatusBadgeControl Status="{Binding Status}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="الإجراءات" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="موافقة" 
                                            Style="{StaticResource SmallSecondaryButtonStyle}"
                                            Click="Approve_Click"
                                            Tag="{Binding ReservationID}"
                                            Margin="0,0,6,0"/>
                                    <Button Content="إلغاء" 
                                            Style="{StaticResource SmallDangerButtonStyle}"
                                            Click="Cancel_Click"
                                            Tag="{Binding ReservationID}"
                                            Margin="0,0,6,0"/>
                                    <Button Content="الفاتورة" 
                                            Style="{StaticResource SmallSecondaryButtonStyle}"
                                            Click="ViewInvoice_Click"
                                            Tag="{Binding ReservationID}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <feedback:EmptyStateControl 
                    Visibility="{Binding Reservations.Count, Converter={StaticResource CountToVisibility}}"
                    IconGeometry="{StaticResource IconReservation}"
                    Title="لا توجد حجوزات حالياً"
                    Description="لم يتم تسجيل أي حجز للأجنحة بعد في النظام، أو لا توجد حجوزات تطابق خيارات التصفية الحالية."/>
            </Grid>
        </Border>

        <!-- Pagination Footer -->
        <nav:PaginationControl Grid.Row="4"
                               CurrentPage="{Binding CurrentPage}"
                               TotalPages="{Binding TotalPages}"
                               TotalCount="{Binding TotalCount}"
                               UnitLabel="حجز"
                               PrevCommand="{Binding PrevPageCommand}"
                               NextCommand="{Binding NextPageCommand}"/>
        <!-- Loading Overlay -->
        <feedback:LoadingOverlayControl Grid.Row="0" Grid.RowSpan="5"
                                         IsLoading="{Binding IsBusy}"
                                         Message="جاري تحميل الحجوزات..."/>
    </Grid>
</UserControl>
