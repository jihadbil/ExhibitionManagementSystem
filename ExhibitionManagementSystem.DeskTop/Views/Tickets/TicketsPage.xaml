<UserControl x:Class="ExhibitionManagementSystem.DeskTop.Views.Tickets.TicketsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:badges="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Badges"
             xmlns:feedback="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Feedback"
             xmlns:nav="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Navigation"
             xmlns:forms="clr-namespace:ExhibitionManagementSystem.DeskTop.Controls.Forms"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             FlowDirection="RightToLeft">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- TabControl Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="إدارة التذاكر والزوار" Style="{StaticResource H1Style}" Margin="0,0,0,24"/>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Style="{StaticResource AppTabControlStyle}">
            <!-- TAB 1: Visitors -->
            <TabItem Header="الزوار المسجلين" Style="{StaticResource AppTabItemStyle}">
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <!-- List (Full width) -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Visitors list card -->
                    <Border Grid.Column="0" Style="{StaticResource StandardCardStyle}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <TextBlock Text="قائمة الزوار المسجلين" Style="{StaticResource H3Style}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                <Button Content="+ تسجيل زائر" 
                                        Style="{StaticResource PrimaryButtonStyle}" 
                                        Click="RegisterVisitor_Click"
                                        VerticalAlignment="Center" 
                                        HorizontalAlignment="Left"
                                        Width="140" Height="36"/>
                            </Grid>

                            <!-- Search -->
                            <forms:SearchBarControl Grid.Row="1" Margin="0,0,0,16"
                                                    SearchText="{Binding VisitorSearch}"
                                                    PlaceholderText="ابحث عن زائر بالاسم، الهاتف، البريد أو الجنسية..."
                                                    SearchCommand="{Binding SearchVisitorsCommand}"/>

                            <!-- DataGrid -->
                            <Grid Grid.Row="2">
                                <DataGrid ItemsSource="{Binding Visitors}"
                                          Style="{StaticResource AppDataGridStyle}"
                                          ColumnHeaderStyle="{StaticResource AppDataGridColumnHeaderStyle}"
                                          RowStyle="{StaticResource AppDataGridRowStyle}"
                                          CellStyle="{StaticResource AppDataGridCellStyle}"
                                          AutoGenerateColumns="False"
                                          Visibility="{Binding Visitors.Count, Converter={StaticResource InverseCountToVisibility}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="2*"/>
                                        <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="1.5*"/>
                                        <DataGridTextColumn Header="البريد الإلكتروني" Binding="{Binding Email}" Width="2*"/>
                                        <DataGridTextColumn Header="الجنسية" Binding="{Binding Nationality}" Width="*"/>
                                        <DataGridTextColumn Header="نوع الزائر" Binding="{Binding VisitorType}" Width="*"/>
                                        <DataGridTextColumn Header="التذاكر المصدرة" Binding="{Binding TicketsCount}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <feedback:EmptyStateControl 
                                    Visibility="{Binding Visitors.Count, Converter={StaticResource CountToVisibility}}"
                                    IconGeometry="{StaticResource IconUsers}"
                                    Title="لا يوجد زوار حالياً"
                                    Description="لم يتم تسجيل أي زائر بعد في النظام أو لا توجد نتائج مطابقة لعملية البحث."/>
                            </Grid>

                            <!-- Pagination -->
                            <nav:PaginationControl Grid.Row="3"
                                                   CurrentPage="{Binding VisitorsCurrentPage}"
                                                   TotalPages="{Binding VisitorsTotalPages}"
                                                   TotalCount="{Binding VisitorsTotalCount}"
                                                   UnitLabel="زائر"
                                                   PrevCommand="{Binding VisitorsPrevPageCommand}"
                                                   NextCommand="{Binding VisitorsNextPageCommand}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: Tickets & QR Scans -->
            <TabItem Header="إصدار ومسح التذاكر" Style="{StaticResource AppTabItemStyle}">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <!-- Exhibition Select filter -->
                        <RowDefinition Height="Auto"/>
                        <!-- Main Splits -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Exhibition Selector -->
                    <Border Grid.Row="0" Style="{StaticResource StandardCardStyle}" Padding="16" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="اختر المعرض" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                            <ComboBox Style="{StaticResource StandardComboBoxStyle}" 
                                      ItemsSource="{Binding Exhibitions}" 
                                      SelectedValuePath="ExhibitionID" 
                                      DisplayMemberPath="Name" 
                                      SelectedValue="{Binding SelectedExhibitionId}"/>
                        </StackPanel>
                    </Border>

                    <!-- Main Splits -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <!-- Tickets Grid List (Full width) -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tickets DataGrid -->
                        <Border Grid.Column="0" Style="{StaticResource StandardCardStyle}" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,16">
                                    <TextBlock Text="قائمة التذاكر المصدرة" Style="{StaticResource H3Style}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                         <Button Style="{StaticResource PrimaryButtonStyle}" 
                                                 Click="IssueTicket_Click"
                                                 Height="36" Margin="0,0,12,0">
                                             <StackPanel Orientation="Horizontal">
                                                 <Path Data="{StaticResource IconTicket}" Width="14" Height="14" Stretch="Uniform" Fill="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                 <TextBlock Text="إصدار تذكرة" VerticalAlignment="Center"/>
                                             </StackPanel>
                                         </Button>
                                         <Button Style="{StaticResource PrimaryButtonStyle}" 
                                                 Click="ScanTicket_Click"
                                                 Height="36">
                                             <StackPanel Orientation="Horizontal">
                                                 <Path Data="{StaticResource IconScan}" Width="14" Height="14" Stretch="Uniform" Fill="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                 <TextBlock Text="مسح تذكرة" VerticalAlignment="Center"/>
                                             </StackPanel>
                                         </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <DataGrid ItemsSource="{Binding Tickets}"
                                              Style="{StaticResource AppDataGridStyle}"
                                              ColumnHeaderStyle="{StaticResource AppDataGridColumnHeaderStyle}"
                                              RowStyle="{StaticResource AppDataGridRowStyle}"
                                              CellStyle="{StaticResource AppDataGridCellStyle}"
                                              AutoGenerateColumns="False"
                                              Visibility="{Binding Tickets.Count, Converter={StaticResource InverseCountToVisibility}}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="رمز التذكرة QR" Binding="{Binding QRCode}" Width="1.5*"/>
                                            <DataGridTextColumn Header="اسم الزائر" Binding="{Binding VisitorName}" Width="2*"/>
                                            <DataGridTextColumn Header="فئة التذكرة" Binding="{Binding TicketType}" Width="*"/>
                                            <DataGridTextColumn Header="السعر" Binding="{Binding Price}" Width="*"/>
                                            <DataGridTextColumn Header="العملة" Binding="{Binding CurrencyCode}" Width="*"/>
                                            <DataGridTextColumn Header="عمليات المسح" Binding="{Binding ScansCount}" Width="*"/>

                                            <DataGridTemplateColumn Header="الحالة" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <badges:StatusBadgeControl Status="{Binding Status}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Actions -->
                                            <DataGridTemplateColumn Header="الإجراءات" Width="Auto">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="إلغاء التذكرة" 
                                                                Style="{StaticResource SmallDangerButtonStyle}"
                                                                Command="{Binding DataContext.CancelTicketCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding TicketID}"
                                                                IsEnabled="{Binding Status, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <feedback:EmptyStateControl 
                                        Visibility="{Binding Tickets.Count, Converter={StaticResource CountToVisibility}}"
                                        IconGeometry="{StaticResource IconTicket}"
                                        Title="لا توجد تذاكر حالياً"
                                        Description="لم يتم إصدار أي تذاكر بعد لهذا المعرض."/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        
        <!-- Loading Overlay -->
        <feedback:LoadingOverlayControl Grid.Row="0" Grid.RowSpan="2"
                                         IsLoading="{Binding IsBusy}"
                                         Message="جاري تحميل البيانات..."/>
    </Grid>
</UserControl>
